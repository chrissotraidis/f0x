diff --git a/src/fast/backends/gfx_metal.cpp b/src/fast/backends/gfx_metal.cpp
index 0a6a3303..8879109d 100644
--- a/src/fast/backends/gfx_metal.cpp
+++ b/src/fast/backends/gfx_metal.cpp
@@ -1274,7 +1274,12 @@ void GfxRenderingAPIMetal::ReadFramebufferToCPU(int fb_id, uint32_t width, uint3
             // First frame on main queue — can't block without deadlock.
             // Return zeros so the caller gets black instead of garbage.
             memset(rgba16_buf, 0, sizeof(uint16_t) * width * height);
-            framebuffer.mUseReadbackQueue = true;
+            // Keep a live render target on the main queue. Moving it permanently
+            // to mReadbackQueue makes the window's main-queue compositor sample
+            // that texture without a cross-queue dependency, so transition
+            // captures turn subsequent presents into an intermittent black strobe.
+            // A missed synchronous snapshot is preferable to corrupting every
+            // following frame; asynchronous offscreen readback is a separate path.
         }

         output_buffer->release();
