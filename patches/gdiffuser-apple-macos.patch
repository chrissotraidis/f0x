+// port/gdx_touch_controls_stub.c — neutral non-iOS touch-controls implementation.
+//
+// macOS, Linux, and Windows builds compile this file so every C/C++ call site
+// (input_bridge.c, main.cpp, the Settings registry) stays platform-neutral.
+// Available() is 0, so the Settings page hides the whole Touch Controls section
+// and the merged pad state is always the physical ControlDeck state. The shared
+// state core still zeroes on read/cancel so behavior is uniform if any port code
+// calls into it.
+
+#include "gdx_touch_controls.h"
+
+#include <stddef.h>
+
+int gdx_touch_controls_available(void) {
+    return 0;
+}
+
+void gdx_touch_controls_start(void) {}
+
+void gdx_touch_controls_prepare_lifecycle(void) {}
+
+void gdx_touch_controls_tick(int menuVisible, int physicalGamepadConnected,
+                             int enabled, float opacity) {
+    (void)menuVisible;
+    (void)physicalGamepadConnected;
+    (void)enabled;
+    (void)opacity;
+}
+
+void gdx_touch_controls_read(GdxTouchPadState* outState) {
+    if (outState != NULL) {
+        outState->buttons = 0;
+        outState->stickX = 0;
+        outState->stickY = 0;
+        outState->stickActive = 0;
+    }
+}
+
+void gdx_touch_controls_cancel_all(void) {
+    gdx_touch_state_cancel_all();
+}
+
+int gdx_touch_controls_app_active(void) {
+    return 1;
+}
+
+void gdx_touch_controls_begin_layout_editor(void) {}
+
+void gdx_touch_controls_reset_current_layout(void) {}
+
+void gdx_touch_controls_set_haptics_enabled(int enabled) {
+    (void)enabled;
+}
+
+void gdx_touch_controls_shutdown(void) {
+    gdx_touch_state_cancel_all();
+}
diff --git a/port/gdx_touch_state.c b/port/gdx_touch_state.c
new file mode 100644
index 0000000..0473737
--- /dev/null
+++ b/port/gdx_touch_state.c
@@ -0,0 +1,232 @@
+// port/gdx_touch_state.c — platform-neutral touch pad state core.
+//
+// Owns the shared atomic pad state (buttons + packed analog stick), the
+// normalized-stick mapping, the port-1 merge helper, and the layout/profile
+// geometry core. The iOS bridge and the neutral stub both delegate their read /
+// cancel behavior here, and the deterministic gdx_touch_merge_tests regression
+// drives these exact functions, so merge/cancel/stick/layout behavior is tested
+// against the code the overlay actually runs.
+//
+// Threading: UIKit touch callbacks and gdx_controller_poll() both run on the
+// host main thread, but the state is published through C11 atomics so a future
+// input worker cannot race the host frame, and the contract's atomic-state
+// requirement holds on every platform.
+
+#include "gdx_touch_controls.h"
+
+#include <math.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+// ── Shared atomic state ───────────────────────────────────────────────────────
+// Stick packing: bit 0 = stickActive, bits 8..15 = stickX (unsigned 8-bit of the
+// signed value), bits 16..23 = stickY. One 32-bit store publishes a coherent
+// snapshot.
+static _Atomic unsigned int sButtons;    // low 16 bits = N64 mask
+static _Atomic unsigned int sStickPacked;
+
+static void gdx_touch_state_publish_stick(signed char x, signed char y, int active) {
+    unsigned int packed = (active ? 1u : 0u) |
+                          ((unsigned int)(unsigned char)x << 8) |
+                          ((unsigned int)(unsigned char)y << 16);
+    atomic_store_explicit(&sStickPacked, packed, memory_order_relaxed);
+}
+
+void gdx_touch_state_set_button(int buttonBit, int pressed) {
+    const unsigned int mask = (unsigned int)buttonBit & 0xFFFFu;
+    if (mask == 0u) {
+        return;
+    }
+    if (pressed != 0) {
+        atomic_fetch_or_explicit(&sButtons, mask, memory_order_relaxed);
+    } else {
+        atomic_fetch_and_explicit(&sButtons, ~mask, memory_order_relaxed);
+    }
+}
+
+// Deadzone as a fraction of full deflection (~10/80 of stick travel).
+#define GDX_TOUCH_STICK_DEADZONE 0.12f
+#define GDX_TOUCH_STICK_MAX 80.0f
+
+void gdx_touch_state_set_stick(float x, float y) {
+    const float length = sqrtf(x * x + y * y);
+
+    if (length <= GDX_TOUCH_STICK_DEADZONE || !isfinite(length)) {
+        gdx_touch_state_publish_stick(0, 0, 0);
+        return;
+    }
+
+    // Clamp the vector to the unit circle before scaling so diagonals stay
+    // inside the N64 -80..80 square.
+    if (length > 1.0f) {
+        x /= length;
+        y /= length;
+    }
+
+    const signed char sx = (signed char)lrintf(x * GDX_TOUCH_STICK_MAX);
+    const signed char sy = (signed char)lrintf(y * GDX_TOUCH_STICK_MAX);
+    gdx_touch_state_publish_stick(sx, sy, 1);
+}
+
+void gdx_touch_state_release_stick(void) {
+    gdx_touch_state_publish_stick(0, 0, 0);
+}
+
+void gdx_touch_state_cancel_all(void) {
+    atomic_store_explicit(&sButtons, 0u, memory_order_relaxed);
+    gdx_touch_state_publish_stick(0, 0, 0);
+}
+
+void gdx_touch_state_read(GdxTouchPadState* outState) {
+    if (outState == NULL) {
+        return;
+    }
+    const unsigned int buttons = atomic_load_explicit(&sButtons, memory_order_relaxed) & 0xFFFFu;
+    const unsigned int packed = atomic_load_explicit(&sStickPacked, memory_order_relaxed);
+    outState->buttons = (unsigned short)buttons;
+    outState->stickActive = (unsigned char)(packed & 1u);
+    outState->stickX = (signed char)((packed >> 8) & 0xFFu);
+    outState->stickY = (signed char)((packed >> 16) & 0xFFu);
+}
+
+// ── Port-1 merge (input_bridge.c calls this after the ControlDeck read) ──────
+void gdx_touch_merge_pad(unsigned short* ioButtons, signed char* ioStickX,
+                         signed char* ioStickY, const GdxTouchPadState* touch) {
+    if (ioButtons != NULL && touch->buttons != 0) {
+        *ioButtons = (unsigned short)(*ioButtons | touch->buttons);
+    }
+    if (touch->stickActive != 0 && ioStickX != NULL && ioStickY != NULL) {
+        *ioStickX = touch->stickX;
+        *ioStickY = touch->stickY;
+    }
+}
+
+// ── Layout / profile core ─────────────────────────────────────────────────────
+// Protected controls can never be hidden: without the stick, accelerator, Start,
+// or the permanent menu affordance a player could strand the game or lose the
+// only way back into the settings.
+int gdx_touch_layout_can_hide(int controlId) {
+    switch (controlId) {
+        case GDX_TOUCH_CTL_STICK:
+        case GDX_TOUCH_CTL_ACCEL:
+        case GDX_TOUCH_CTL_START:
+        case GDX_TOUCH_CTL_MENU:
+            return 0;
+        default:
+            return 1;
+    }
+}
+
+static float gdx_touch_clampf(float v, float lo, float hi) {
+    if (v < lo) {
+        return lo;
+    }
+    if (v > hi) {
+        return hi;
+    }
+    return v;
+}
+
+void gdx_touch_layout_apply(const GdxTouchControlSpec* defaults, int defaultCount,
+                            const GdxTouchControlSpec* overrides, int overrideCount,
+                            float safeX0, float safeY0, float safeW, float safeH,
+                            GdxTouchControlSpec* out, int outCapacity) {
+    int i;
+    const int count = (defaultCount < outCapacity) ? defaultCount : outCapacity;
+    float x0 = safeX0;
+    float y0 = safeY0;
+    float x1 = safeX0 + safeW;
+    float y1 = safeY0 + safeH;
+
+    if (x1 <= x0) {
+        x0 = 0.0f;
+        x1 = 1.0f;
+    }
+    if (y1 <= y0) {
+        y0 = 0.0f;
+        y1 = 1.0f;
+    }
+
+    for (i = 0; i < count; i++) {
+        out[i] = defaults[i];
+    }
+    for (i = 0; i < overrideCount; i++) {
+        int j;
+        for (j = 0; j < count; j++) {
+            if (out[j].controlId == overrides[i].controlId) {
+                out[j] = overrides[i];
+                break;
+            }
+        }
+    }
+    for (i = 0; i < count; i++) {
+        out[i].scale = gdx_touch_clampf(out[i].scale, 0.70f, 1.50f);
+        if (!gdx_touch_layout_can_hide(out[i].controlId)) {
+            out[i].hidden = 0;
+        }
+        out[i].centerX = gdx_touch_clampf(out[i].centerX, x0, x1);
+        out[i].centerY = gdx_touch_clampf(out[i].centerY, y0, y1);
+    }
+}
+
+#define GDX_TOUCH_PROFILE_VERSION "v1"
+
+int gdx_touch_profile_encode(const GdxTouchControlSpec* specs, int count,
+                             char* out, int outCapacity) {
+    int written = 0;
+    int i;
+    if (out == NULL || outCapacity <= 0) {
+        return 0;
+    }
+    out[0] = '\0';
+    for (i = 0; i < count; i++) {
+        const int need = snprintf(NULL, 0, "%s %d %.6f %.6f %.3f %d\n",
+                                  GDX_TOUCH_PROFILE_VERSION, specs[i].controlId,
+                                  (double)specs[i].centerX, (double)specs[i].centerY,
+                                  (double)specs[i].scale, specs[i].hidden ? 1 : 0);
+        if (need < 0 || written + need + 1 > outCapacity) {
+            return 0; // truncation: caller keeps the previous profile
+        }
+        written += snprintf(out + written, (size_t)(outCapacity - written),
+                            "%s %d %.6f %.6f %.3f %d\n", GDX_TOUCH_PROFILE_VERSION,
+                            specs[i].controlId, (double)specs[i].centerX,
+                            (double)specs[i].centerY, (double)specs[i].scale,
+                            specs[i].hidden ? 1 : 0);
+    }
+    return written;
+}
+
+int gdx_touch_profile_decode(const char* text, GdxTouchControlSpec* out,
+                             int outCapacity) {
+    int count = 0;
+    const char* p = text;
+    char version[8];
+    if (text == NULL || out == NULL || outCapacity <= 0) {
+        return 0;
+    }
+    while (p != NULL && *p != '\0' && count < outCapacity) {
+        int id = -1;
+        int hidden = 0;
+        float x = 0.0f;
+        float y = 0.0f;
+        float scale = 1.0f;
+        int n = sscanf(p, "%7s %d %f %f %f %d", version, &id, &x, &y, &scale, &hidden);
+        if (n != 6 || strcmp(version, GDX_TOUCH_PROFILE_VERSION) != 0 ||
+            id < 0 || id >= GDX_TOUCH_CTL_COUNT || scale <= 0.0f) {
+            break; // malformed or a future version: stop, keep what we parsed
+        }
+        out[count].controlId = id;
+        out[count].centerX = x;
+        out[count].centerY = y;
+        out[count].scale = scale;
+        out[count].hidden = hidden ? 1 : 0;
+        count++;
+        p = strchr(p, '\n');
+        if (p != NULL) {
+            p++;
+        }
+    }
+    return count;
+}
