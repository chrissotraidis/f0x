+            bool vsync = CVarGetInteger("gVsyncEnabled", 1) != 0;
+            if (ImGui::Checkbox("VSync", &vsync)) {
+                CVarSetInteger("gVsyncEnabled", vsync ? 1 : 0);
+                CVarSave();
+            }
+            ImGui::SameLine();
+            bool widescreen = CVarGetInteger("gEnhancements.Graphics.Widescreen", 1) != 0;
+            if (ImGui::Checkbox("Widescreen", &widescreen)) {
+                CVarSetInteger("gEnhancements.Graphics.Widescreen", widescreen ? 1 : 0);
+                CVarSave();
+            }
+            ImGui::SameLine();
+            bool fullscreen = w->IsFullscreen();
+            if (ImGui::Checkbox("Fullscreen", &fullscreen)) {
+                w->SetFullscreen(fullscreen);
+            }
+
+            ImGui::Spacing();
+            ImGui::TextDisabled("More graphics, audio, controls, and accessibility settings are available in-game.");
+            ImGui::TextDisabled("If game data becomes invalid, choose Manage Game Data to repair or replace it.");
+            ImGui::Spacing();
+            ImGui::Separator();
+            ImGui::Spacing();
+            if (ImGui::Button("Quit F0X")) {
+                action = F0XHomeAction::Quit;
+                finished = true;
+            }
+            if (blockInput) {
+                ImGui::EndDisabled();
+                --inputGuardFrames;
+            }
+        }
+        ImGui::End();
+        ImGui::PopStyleColor(5);
+        ImGui::PopStyleVar(5);
+
+        w->StartFrame();
+        w->RunGuiOnly();
+        w->GetGui()->EndDraw();
+        w->EndFrame();
+    }
+    if (!keyboardNavWasEnabled) {
+        io.ConfigFlags &= ~ImGuiConfigFlags_NavEnableKeyboard;
+    }
+    return finished ? action : F0XHomeAction::Quit;
+}
+
 } // namespace gdx
