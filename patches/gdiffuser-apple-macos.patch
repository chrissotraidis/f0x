diff --git a/port/tests/diagnostics_tests.c b/port/tests/diagnostics_tests.c
new file mode 100644
index 0000000..2023a5f
--- /dev/null
+++ b/port/tests/diagnostics_tests.c
@@ -0,0 +1,123 @@
+// gdx_diagnostics_tests — deterministic checks for the report builder.
+// Compiles gdx_diagnostics.c UNMODIFIED, exactly like the app does.
+
+#include "gdx_diagnostics.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static int s_failures = 0;
+
+static void check(int ok, const char* what) {
+    if (!ok) {
+        printf("FAIL: %s\n", what);
+        s_failures++;
+    }
+}
+
+static void fill_fixed(GdxDiagnosticsSource* src) {
+    memset(src, 0, sizeof(*src));
+    gdx_diagnostics_set_field(src->app, sizeof(src->app), "F0X");
+    gdx_diagnostics_set_field(src->version, sizeof(src->version), "dev");
+    gdx_diagnostics_set_field(src->build, sizeof(src->build), "Debug cartridge-only");
+    gdx_diagnostics_set_field(src->platform, sizeof(src->platform), "Apple Silicon macOS");
+    gdx_diagnostics_set_field(src->os, sizeof(src->os), "macOS 26.6");
+    gdx_diagnostics_set_field(src->arch, sizeof(src->arch), "arm64");
+    gdx_diagnostics_set_field(src->renderer, sizeof(src->renderer), "Fast3D / Metal");
+    gdx_diagnostics_set_field(src->metalDevice, sizeof(src->metalDevice), "Apple M5");
+    gdx_diagnostics_set_field(src->window, sizeof(src->window), "1440x870");
+    gdx_diagnostics_set_field(src->refresh, sizeof(src->refresh), "60");
+    gdx_diagnostics_set_field(src->interpTarget, sizeof(src->interpTarget), "60");
+    gdx_diagnostics_set_field(src->dataDirClass, sizeof(src->dataDirClass),
+                              "user Application Support (mutable)");
+    gdx_diagnostics_set_field(src->archive, sizeof(src->archive),
+                              "fzerox.o2r present, validated");
+    gdx_diagnostics_set_field(src->save, sizeof(src->save), "fzerox.sav present (32768 bytes)");
+    gdx_diagnostics_set_field(src->controllers, sizeof(src->controllers), "0 SDL joystick(s)");
+    gdx_diagnostics_set_field(src->touch, sizeof(src->touch), "desktop stub (neutral)");
+    gdx_diagnostics_set_field(src->scheduler, sizeof(src->scheduler),
+                              "ucontext (POSIX) cooperative fibers");
+    gdx_diagnostics_set_field(src->audio, sizeof(src->audio), "not initialized (Home surface)");
+    gdx_diagnostics_set_field(src->timing, sizeof(src->timing), "pre-game (Home surface)");
+    gdx_diagnostics_set_field(src->gameMode, sizeof(src->gameMode), "pre-game (F0X Home)");
+    gdx_diagnostics_set_field(src->errors, sizeof(src->errors), "none");
+    gdx_diagnostics_set_field(src->notes, sizeof(src->notes), "deterministic test fixture");
+}
+
+int main(void) {
+    GdxDiagnosticsSource src;
+    fill_fixed(&src);
+
+    char report[GDX_DIAG_MAX_REPORT];
+    int n = gdx_diagnostics_build_report(&src, report, sizeof(report));
+    check(n > 0 && n < (int) sizeof(report), "report has content within capacity");
+    check(report[n] == '\0', "report NUL-terminated at returned length");
+
+    const char* sections[] = { "[App]", "[System]", "[Renderer]", "[Game Data]", "[Input]",
+                               "[Scheduler]", "[Audio]", "[Timing]", "[Game State]", "[Errors]",
+                               "[Notes]" };
+    for (size_t i = 0; i < sizeof(sections) / sizeof(sections[0]); i++) {
+        check(strstr(report, sections[i]) != NULL, sections[i]);
+    }
+
+    const char* fields[] = { "= F0X", "= arm64", "= Apple M5",
+                             "= fzerox.o2r present, validated",
+                             "= 0 SDL joystick(s)", "= desktop stub (neutral)",
+                             "= pre-game (F0X Home)" };
+    for (size_t i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+        check(strstr(report, fields[i]) != NULL, fields[i]);
+    }
+
+    // Determinism: identical input -> identical output.
+    char report2[GDX_DIAG_MAX_REPORT];
+    gdx_diagnostics_build_report(&src, report2, sizeof(report2));
+    check(strcmp(report, report2) == 0, "deterministic output");
+
+    // Empty source is still well-formed with "unknown" values.
+    GdxDiagnosticsSource empty;
+    memset(&empty, 0, sizeof(empty));
+    char emptyReport[GDX_DIAG_MAX_REPORT];
+    int en = gdx_diagnostics_build_report(&empty, emptyReport, sizeof(emptyReport));
+    check(en > 0, "empty source renders");
+    check(strstr(emptyReport, "= unknown") != NULL, "empty field renders unknown");
+
+    // Truncation safety: tiny buffer stays NUL-terminated and never overflows.
+    char tiny[64];
+    int tn = gdx_diagnostics_build_report(&src, tiny, sizeof(tiny));
+    check(tn >= 0 && tn < (int) sizeof(tiny), "tiny buffer bounded");
+    check(tiny[sizeof(tiny) - 1] == '\0', "tiny buffer NUL-terminated");
+
+    // Privacy scrub: secret-like content is redacted in every field.
+    GdxDiagnosticsSource leaky;
+    fill_fixed(&leaky);
+    gdx_diagnostics_set_field(leaky.errors, sizeof(leaky.errors),
+                              "auth token=abc123 leaked");
+    gdx_diagnostics_set_field(leaky.notes, sizeof(leaky.notes),
+                              "BEGIN PRIVATE KEY material");
+    gdx_diagnostics_set_field(leaky.metalDevice, sizeof(leaky.metalDevice),
+                              "device secret name");
+    char leakyReport[GDX_DIAG_MAX_REPORT];
+    gdx_diagnostics_build_report(&leaky, leakyReport, sizeof(leakyReport));
+    check(strstr(leakyReport, "abc123") == NULL, "token value redacted");
+    check(strstr(leakyReport, "BEGIN PRIVATE") == NULL, "private-key block redacted");
+    check(strstr(leakyReport, "[REDACTED]") != NULL, "redaction marker present");
+    check(strstr(leakyReport, "secret name") == NULL, "secret-like device name redacted");
+
+    // NULL source is tolerated.
+    char nullReport[128];
+    int nn = gdx_diagnostics_build_report(NULL, nullReport, sizeof(nullReport));
+    check(nn > 0 && nullReport[nn] == '\0', "NULL source tolerated");
+
+    // Field helpers bound writes.
+    char field[8];
+    gdx_diagnostics_set_field(field, sizeof(field), "0123456789");
+    check(strcmp(field, "0123456") == 0, "set_field truncates safely");
+    check(field[sizeof(field) - 1] == '\0', "set_field NUL-terminates");
+
+    if (s_failures == 0) {
+        printf("gdx_diagnostics_tests: all checks passed\n");
+        return 0;
+    }
+    printf("gdx_diagnostics_tests: %d failure(s)\n", s_failures);
+    return 1;
+}
diff --git a/port/tests/touch_merge_tests.c b/port/tests/touch_merge_tests.c
new file mode 100644
index 0000000..8fa28ff
--- /dev/null
+++ b/port/tests/touch_merge_tests.c
@@ -0,0 +1,325 @@
+/* Standalone unit-test harness for port/gdx_touch_state.c (the touch pad state
+ * core the iOS overlay and the neutral stub both run). Console exe, no game
+ * deps, no libultraship, no decomp headers: the module compiles unmodified
+ * alongside this file (see port/CMakeLists.txt's gdx_touch_merge_tests) and is
+ * driven entirely through its public API.
+ *
+ * This regression fails before the merge/cancel/stick/profile implementation
+ * exists (the symbols are absent) and covers the F0X touch contract:
+ *   - every N64 button bit OR-merges with live physical input;
+ *   - an inactive touch stick leaves the physical analog untouched;
+ *   - an active touch stick owns only the two analog axes;
+ *   - releasing/cancelling restores the physical stick on the next poll;
+ *   - simultaneous accelerator + steering + brake/boost/Z/R merge together;
+ *   - menu/editor/background transitions clear all state (cancel_all);
+ *   - the normalized stick maps continuously to -80..80 with circle clamping,
+ *     sign correctness, and a deadzone that publishes stickActive=0;
+ *   - layout overrides apply by id, clamp into the safe area, clamp scale into
+ *     70%..150%, and never hide protected controls;
+ *   - profile encode/decode round-trips deterministically.
+ */
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "gdx_touch_controls.h"
+
+static int gSubChecks = 0;
+static int gSubFails = 0;
+
+static void checkTrue(const char* what, int cond) {
+    gSubChecks++;
+    if (!cond) {
+        gSubFails++;
+        printf("    [x] %s\n", what);
+    }
+}
+
+static void checkEq(const char* what, long got, long expected) {
+    gSubChecks++;
+    if (got != expected) {
+        gSubFails++;
+        printf("    [x] %s: got %ld, expected %ld\n", what, got, expected);
+    }
+}
+
+static void case_button_merge_every_bit(void) {
+    static const struct {
+        const char* name;
+        unsigned short bit;
+    } kBits[] = {
+        { "CRIGHT", GDX_TOUCH_BTN_CRIGHT }, { "CLEFT", GDX_TOUCH_BTN_CLEFT },
+        { "CDOWN", GDX_TOUCH_BTN_CDOWN },   { "CUP", GDX_TOUCH_BTN_CUP },
+        { "R", GDX_TOUCH_BTN_R },           { "L", GDX_TOUCH_BTN_L },
+        { "DRIGHT", GDX_TOUCH_BTN_DRIGHT }, { "DLEFT", GDX_TOUCH_BTN_DLEFT },
+        { "DDOWN", GDX_TOUCH_BTN_DDOWN },   { "DUP", GDX_TOUCH_BTN_DUP },
+        { "START", GDX_TOUCH_BTN_START },   { "Z", GDX_TOUCH_BTN_Z },
+        { "B", GDX_TOUCH_BTN_B },           { "A", GDX_TOUCH_BTN_A },
+    };
+    size_t i;
+
+    printf("  case: every N64 button bit OR-merges into port 1\n");
+    for (i = 0; i < sizeof(kBits) / sizeof(kBits[0]); i++) {
+        GdxTouchPadState touch;
+        unsigned short buttons = GDX_TOUCH_BTN_START; /* live physical input */
+        signed char sx = 20;
+        signed char sy = -30;
+        char name[64];
+
+        gdx_touch_state_cancel_all();
+        gdx_touch_state_set_button(kBits[i].bit, 1);
+        gdx_touch_state_read(&touch);
+        buttons = GDX_TOUCH_BTN_START; /* fresh live physical input each merge */
+        gdx_touch_merge_pad(&buttons, &sx, &sy, &touch);
+        snprintf(name, sizeof(name), "%s bit set appears in merged pad", kBits[i].name);
+        checkTrue(name, (buttons & kBits[i].bit) != 0);
+        checkTrue("physical buttons still present", (buttons & GDX_TOUCH_BTN_START) != 0);
+
+        gdx_touch_state_set_button(kBits[i].bit, 0);
+        gdx_touch_state_read(&touch);
+        buttons = GDX_TOUCH_BTN_START;
+        gdx_touch_merge_pad(&buttons, &sx, &sy, &touch);
+        snprintf(name, sizeof(name), "%s release leaves exactly the physical pad", kBits[i].name);
+        checkTrue(name, buttons == GDX_TOUCH_BTN_START);
+    }
+    gdx_touch_state_cancel_all();
+}
+
+static void case_stick_mapping(void) {
+    GdxTouchPadState touch;
+
+    printf("  case: normalized stick maps continuously to -80..80\n");
+
+    gdx_touch_state_cancel_all();
+    gdx_touch_state_set_stick(1.0f, 0.0f);
+    gdx_touch_state_read(&touch);
+    checkEq("full right -> x=80", touch.stickX, 80);
+    checkEq("full right -> y=0", touch.stickY, 0);
+    checkEq("full right -> active", touch.stickActive, 1);
+
+    gdx_touch_state_set_stick(0.0f, -1.0f);
+    gdx_touch_state_read(&touch);
+    checkEq("full down -> y=-80 (sign preserved)", touch.stickY, -80);
+    checkEq("full down -> x=0", touch.stickX, 0);
+
+    gdx_touch_state_set_stick(0.5f, 0.0f);
+    gdx_touch_state_read(&touch);
+    checkEq("half right -> x=40", touch.stickX, 40);
+
+    /* A unit diagonal clamps to the circle: each axis = 0.7071*80 = 57. */
+    gdx_touch_state_set_stick(0.70710678f, 0.70710678f);
+    gdx_touch_state_read(&touch);
+    checkEq("diagonal x clamped to circle", touch.stickX, 57);
+    checkEq("diagonal y clamped to circle", touch.stickY, 57);
+
+    /* Out-of-range input clamps to the unit circle, never exceeds 80. */
+    gdx_touch_state_set_stick(3.0f, 0.0f);
+    gdx_touch_state_read(&touch);
+    checkEq("overshoot x clamps at 80", touch.stickX, 80);
+    checkEq("overshoot y stays 0", touch.stickY, 0);
+
+    gdx_touch_state_cancel_all();
+}
+
+static void case_stick_deadzone_and_release(void) {
+    GdxTouchPadState touch;
+
+    printf("  case: deadzone + release publish inactive stick\n");
+    gdx_touch_state_cancel_all();
+    gdx_touch_state_set_stick(0.05f, 0.0f); /* inside the deadzone */
+    gdx_touch_state_read(&touch);
+    checkEq("deadzone -> inactive", touch.stickActive, 0);
+    checkEq("deadzone -> x neutral", touch.stickX, 0);
+    checkEq("deadzone -> y neutral", touch.stickY, 0);
+
+    gdx_touch_state_set_stick(0.6f, 0.3f);
+    gdx_touch_state_release_stick();
+    gdx_touch_state_read(&touch);
+    checkEq("release -> inactive", touch.stickActive, 0);
+    checkEq("release -> x neutral", touch.stickX, 0);
+    checkEq("release -> y neutral", touch.stickY, 0);
+}
+
+static void case_merge_stick_semantics(void) {
+    GdxTouchPadState touch;
+
+    printf("  case: physical stick preserved, touch stick owns axes only\n");
+    gdx_touch_state_cancel_all();
+
+    /* Inactive touch stick: physical analog untouched. */
+    gdx_touch_state_read(&touch);
+    {
+        unsigned short buttons = 0;
+        signed char sx = 40;
+        signed char sy = -50;
+        gdx_touch_merge_pad(&buttons, &sx, &sy, &touch);
+        checkEq("inactive touch leaves physical x", sx, 40);
+        checkEq("inactive touch leaves physical y", sy, -50);
+        checkEq("inactive touch leaves buttons", buttons, 0);
+    }
+
+    /* Active touch stick: owns both axes, buttons still OR. */
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_A, 1);
+    gdx_touch_state_set_stick(-0.5f, 0.8f);
+    gdx_touch_state_read(&touch);
+    {
+        unsigned short buttons = GDX_TOUCH_BTN_B;
+        signed char sx = 40;
+        signed char sy = -50;
+        gdx_touch_merge_pad(&buttons, &sx, &sy, &touch);
+        checkEq("active touch overrides x", sx, -40);
+        checkEq("active touch overrides y", sy, 64);
+        checkEq("touch A merged with physical B", buttons,
+                (unsigned short)(GDX_TOUCH_BTN_A | GDX_TOUCH_BTN_B));
+    }
+
+    /* Releasing the touch restores the physical analog on the next poll. */
+    gdx_touch_state_release_stick();
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_A, 0);
+    gdx_touch_state_read(&touch);
+    {
+        unsigned short buttons = 0;
+        signed char sx = 40;
+        signed char sy = -50;
+        gdx_touch_merge_pad(&buttons, &sx, &sy, &touch);
+        checkEq("release restores physical x", sx, 40);
+        checkEq("release restores physical y", sy, -50);
+    }
+
+    gdx_touch_state_cancel_all();
+}
+
+static void case_simultaneous_inputs(void) {
+    GdxTouchPadState touch;
+
+    printf("  case: steering + accelerator + brake/boost/Z/R merge together\n");
+    gdx_touch_state_cancel_all();
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_A, 1);
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_B, 1);
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_CDOWN, 1);
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_Z, 1);
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_R, 1);
+    gdx_touch_state_set_stick(1.0f, 0.0f);
+    gdx_touch_state_read(&touch);
+    {
+        unsigned short buttons = 0;
+        signed char sx = 0;
+        signed char sy = 0;
+        gdx_touch_merge_pad(&buttons, &sx, &sy, &touch);
+        checkEq("all action buttons present", buttons,
+                (unsigned short)(GDX_TOUCH_BTN_A | GDX_TOUCH_BTN_B | GDX_TOUCH_BTN_CDOWN |
+                                 GDX_TOUCH_BTN_Z | GDX_TOUCH_BTN_R));
+        checkEq("steering x present", sx, 80);
+        checkEq("steering y neutral", sy, 0);
+    }
+    gdx_touch_state_cancel_all();
+}
+
+static void case_cancel_transitions(void) {
+    GdxTouchPadState touch;
+
+    printf("  case: menu/editor/background cancel clears buttons and stick\n");
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_A, 1);
+    gdx_touch_state_set_button(GDX_TOUCH_BTN_START, 1);
+    gdx_touch_state_set_stick(-0.9f, 0.9f);
+    gdx_touch_state_read(&touch);
+    checkEq("input latched before cancel", touch.buttons != 0, 1);
+    checkEq("stick active before cancel", touch.stickActive, 1);
+
+    gdx_touch_state_cancel_all();
+    gdx_touch_state_read(&touch);
+    checkEq("cancel clears buttons", touch.buttons, 0);
+    checkEq("cancel clears stick", touch.stickActive, 0);
+    checkEq("cancel neutral x", touch.stickX, 0);
+    checkEq("cancel neutral y", touch.stickY, 0);
+}
+
+static void case_layout_apply(void) {
+    GdxTouchControlSpec defaults[GDX_TOUCH_CTL_COUNT];
+    GdxTouchControlSpec overrides[2];
+    GdxTouchControlSpec out[GDX_TOUCH_CTL_COUNT];
+    int i;
+
+    printf("  case: layout overrides, clamp, scale clamp, hide protection\n");
+    for (i = 0; i < GDX_TOUCH_CTL_COUNT; i++) {
+        defaults[i].controlId = i;
+        defaults[i].centerX = 0.5f;
+        defaults[i].centerY = 0.5f;
+        defaults[i].scale = 1.0f;
+        defaults[i].hidden = 0;
+    }
+    /* Override the stick position (protected: cannot hide) and the D-pad scale. */
+    overrides[0] = defaults[GDX_TOUCH_CTL_STICK];
+    overrides[0].centerX = 0.05f; /* outside the safe rect, must clamp */
+    overrides[0].hidden = 1;      /* protected: must be forced back to visible */
+    overrides[1] = defaults[GDX_TOUCH_CTL_DPAD];
+    overrides[1].scale = 3.0f; /* outside 70%..150%, must clamp */
+
+    gdx_touch_layout_apply(defaults, GDX_TOUCH_CTL_COUNT, overrides, 2,
+                           0.10f, 0.10f, 0.80f, 0.80f, out, GDX_TOUCH_CTL_COUNT);
+    checkEq("stick x clamped to safe rect", out[GDX_TOUCH_CTL_STICK].centerX == 0.10f, 1);
+    checkEq("stick cannot hide", out[GDX_TOUCH_CTL_STICK].hidden, 0);
+    checkEq("dpad scale clamped to 1.50", out[GDX_TOUCH_CTL_DPAD].scale == 1.50f, 1);
+    checkEq("unoverridden control keeps default", out[GDX_TOUCH_CTL_ACCEL].centerX == 0.5f, 1);
+    checkEq("menu control cannot hide", out[GDX_TOUCH_CTL_MENU].hidden, 0);
+    checkEq("start control cannot hide", out[GDX_TOUCH_CTL_START].hidden, 0);
+    checkEq("accelerator control cannot hide", out[GDX_TOUCH_CTL_ACCEL].hidden, 0);
+
+    /* An empty safe rect falls back to the full 0..1 range. */
+    gdx_touch_layout_apply(defaults, GDX_TOUCH_CTL_COUNT, overrides, 2,
+                           0.5f, 0.5f, 0.0f, 0.0f, out, GDX_TOUCH_CTL_COUNT);
+    checkEq("degenerate safe rect x fallback", out[GDX_TOUCH_CTL_STICK].centerX >= 0.0f &&
+                                                   out[GDX_TOUCH_CTL_STICK].centerX <= 1.0f, 1);
+}
+
+static void case_profile_roundtrip(void) {
+    GdxTouchControlSpec specs[GDX_TOUCH_CTL_COUNT];
+    GdxTouchControlSpec decoded[GDX_TOUCH_CTL_COUNT];
+    char buffer[1024];
+    int len;
+    int count;
+    int i;
+    int identical = 1;
+
+    printf("  case: profile encode/decode round-trip\n");
+    for (i = 0; i < GDX_TOUCH_CTL_COUNT; i++) {
+        specs[i].controlId = i;
+        specs[i].centerX = 0.10f + 0.06f * (float)i;
+        specs[i].centerY = 0.80f - 0.05f * (float)i;
+        specs[i].scale = 0.80f + 0.05f * (float)i;
+        specs[i].hidden = (i % 3) == 0 ? 1 : 0;
+    }
+    len = gdx_touch_profile_encode(specs, GDX_TOUCH_CTL_COUNT, buffer, (int)sizeof(buffer));
+    checkTrue("encode wrote content", len > 0);
+    count = gdx_touch_profile_decode(buffer, decoded, GDX_TOUCH_CTL_COUNT);
+    checkEq("decode reads all controls", count, GDX_TOUCH_CTL_COUNT);
+    for (i = 0; i < count && i < GDX_TOUCH_CTL_COUNT; i++) {
+        if (decoded[i].controlId != specs[i].controlId ||
+            fabsf(decoded[i].centerX - specs[i].centerX) > 1e-5f ||
+            fabsf(decoded[i].centerY - specs[i].centerY) > 1e-5f ||
+            fabsf(decoded[i].scale - specs[i].scale) > 1e-3f ||
+            decoded[i].hidden != specs[i].hidden) {
+            identical = 0;
+        }
+    }
+    checkTrue("decoded values match encoded values", identical);
+
+    /* Unknown future version: decode stops without corrupting earlier entries. */
+    count = gdx_touch_profile_decode("v9 1 0.5 0.5 1.0 0\n", decoded, GDX_TOUCH_CTL_COUNT);
+    checkEq("future version rejected cleanly", count, 0);
+}
+
+int main(void) {
+    printf("gdx_touch_merge_tests: N64 touch merge/cancel/stick/layout core\n");
+    case_button_merge_every_bit();
+    case_stick_mapping();
+    case_stick_deadzone_and_release();
+    case_merge_stick_semantics();
+    case_simultaneous_inputs();
+    case_cancel_transitions();
+    case_layout_apply();
+    case_profile_roundtrip();
+
+    printf("sub-checks: %d, failures: %d\n", gSubChecks, gSubFails);
+    return gSubFails == 0 ? 0 : 1;
+}
