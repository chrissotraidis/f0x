+// ── Device-class data ─────────────────────────────────────────────────────────
+// Defaults adapted from the HarkinianPad reference (pinned at 1197472) accepted
+// physical layouts: the normalized centers promoted from the accepted phone and
+// tablet profiles (customizable-touch-controls.patch), the base sizes from the
+// grip-first design (touch-controls-design.md), and the L/R/Start/D-pad base
+// rail positions from that design's frame math. Centers are FULL-WINDOW
+// normalized (0..1 of the window), exactly like the reference's
+// finishControlLayoutForCompact; the platform-neutral layout core clamps them
+// into the live safe rect. Sizes are base point sizes at scale 1.0; the editor
+// rescales them 70%..150%.
+typedef struct GdxBaseSpec {
+    int controlId;
+    float x;
+    float y;
+    float baseSize;     // square side (or pill width, see below)
+    float baseHeight;   // pill controls only; 0 means square
+} GdxBaseSpec;
