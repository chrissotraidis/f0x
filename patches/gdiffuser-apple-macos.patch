+/* Minimal cooperative context switch for arm64 iOS.
+ *
+ * Only AAPCS64 callee-saved state crosses a normal C call: x19-x30, sp, and
+ * d8-d15. New fibers start by restoring their prepared sp/lr pair and returning
+ * into the C trampoline. Resumed fibers return to the instruction following
+ * their original gdx_fiber_arm64_switch call.
+ */
+.text
+.p2align 2
+.globl _gdx_fiber_arm64_switch
+_gdx_fiber_arm64_switch:
+    stp x19, x20, [x0, #0]
+    stp x21, x22, [x0, #16]
+    stp x23, x24, [x0, #32]
+    stp x25, x26, [x0, #48]
+    stp x27, x28, [x0, #64]
+    stp x29, x30, [x0, #80]
+    mov x2, sp
+    str x2, [x0, #96]
+    stp d8, d9, [x0, #104]
+    stp d10, d11, [x0, #120]
+    stp d12, d13, [x0, #136]
+    stp d14, d15, [x0, #152]
+
+    ldp x19, x20, [x1, #0]
+    ldp x21, x22, [x1, #16]
+    ldp x23, x24, [x1, #32]
+    ldp x25, x26, [x1, #48]
+    ldp x27, x28, [x1, #64]
+    ldp x29, x30, [x1, #80]
+    ldr x2, [x1, #96]
+    ldp d8, d9, [x1, #104]
+    ldp d10, d11, [x1, #120]
+    ldp d12, d13, [x1, #136]
+    ldp d14, d15, [x1, #152]
+    mov sp, x2
+    ret
