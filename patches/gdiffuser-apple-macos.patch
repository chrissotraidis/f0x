+#include "gdx_input_editor_window.h"
+
+#include <algorithm>
+
+#include <imgui.h>
+
+void GdxInputEditorWindow::Draw() {
+#if defined(__APPLE__) && defined(__ENVIRONMENT_IPHONE_OS_VERSION_MIN_REQUIRED__)
+    if (!IsVisible()) {
+        return;
+    }
+
+    ImGuiViewport* viewport = ImGui::GetMainViewport();
+    if (viewport != nullptr) {
+        // The SDL/ImGui viewport already represents the UIKit drawable's safe
+        // content. A small visual gutter keeps the close affordance and scroll
+        // bar away from the device edge while using the width required by the
+        // editor's mapping rows on both iPhone and iPad landscape.
+        const float gutter = std::max(8.0f, ImGui::GetFontSize() * 0.75f);
+        const ImVec2 size(std::max(320.0f, viewport->WorkSize.x - gutter * 2.0f),
+                          std::max(240.0f, viewport->WorkSize.y - gutter * 2.0f));
+        ImGui::SetNextWindowPos(viewport->WorkPos + ImVec2(gutter, gutter), ImGuiCond_Always);
+        ImGui::SetNextWindowSize(size, ImGuiCond_Always);
+        ImGui::SetNextWindowCollapsed(false, ImGuiCond_Always);
+    }
+
+    // These values are scoped to this window and all of its sections. They
+    // preserve the existing desktop density while giving mobile controls a
+    // comfortable touch target and readable separation throughout.
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding,
+                        ImVec2(ImGui::GetFontSize() * 0.75f, ImGui::GetFontSize() * 0.75f));
+    ImGui::PushStyleVar(ImGuiStyleVar_FramePadding,
+                        ImVec2(ImGui::GetFontSize() * 0.55f, ImGui::GetFontSize() * 0.38f));
+    ImGui::PushStyleVar(ImGuiStyleVar_ItemSpacing,
+                        ImVec2(ImGui::GetFontSize() * 0.55f, ImGui::GetFontSize() * 0.45f));
+    LUS::InputEditorWindow::Draw();
+    ImGui::PopStyleVar(3);
+#else
+    LUS::InputEditorWindow::Draw();
+#endif
+}
