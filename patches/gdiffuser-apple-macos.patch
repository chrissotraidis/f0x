diff --git a/port/gdx_firstboot_picker.mm b/port/gdx_firstboot_picker.mm
new file mode 100644
index 0000000..7ec09fa
--- /dev/null
+++ b/port/gdx_firstboot_picker.mm
@@ -0,0 +1,62 @@
+// Native macOS file-picker bridge for the in-window first-launch setup.
+
+#import <AppKit/AppKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include <string>
+
+namespace {
+
+std::string pickFile(NSString* title, NSArray<UTType*>* contentTypes) {
+    @autoreleasepool {
+        NSOpenPanel* panel = [NSOpenPanel openPanel];
+        panel.title = title;
+        panel.message = @"Choose a local game-data file. F0X copies it into its Application Support folder.";
+        panel.canChooseFiles = YES;
+        panel.canChooseDirectories = NO;
+        panel.allowsMultipleSelection = NO;
+        panel.allowedContentTypes = contentTypes;
+        if ([panel runModal] != NSModalResponseOK || panel.URL == nil) {
+            return {};
+        }
+        return panel.URL.path.UTF8String;
+    }
+}
+
+} // namespace
+
+namespace gdx {
+
+std::string GdxPickRomFileMacOS() {
+    return pickFile(@"Select your F-Zero X ROM (US rev0)", @[
+        [UTType typeWithFilenameExtension:@"z64"],
+        [UTType typeWithFilenameExtension:@"n64"],
+        [UTType typeWithFilenameExtension:@"v64"],
+    ]);
+}
+
+std::string GdxPickDiskFileMacOS() {
+    return pickFile(@"Select your F-Zero X Expansion Kit disk", @[
+        [UTType typeWithFilenameExtension:@"ndd"],
+    ]);
+}
+
+std::string GdxPickIplFileMacOS() {
+    return pickFile(@"Select your 64DD IPL ROM", @[
+        [UTType typeWithFilenameExtension:@"n64"],
+        [UTType typeWithFilenameExtension:@"z64"],
+    ]);
+}
+
+bool GdxRevealDataDirectoryMacOS(const std::string& path) {
+    @autoreleasepool {
+        if (path.empty()) {
+            return false;
+        }
+        NSURL* url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path.c_str()]
+                               isDirectory:YES];
+        return url != nil && [[NSWorkspace sharedWorkspace] openURL:url];
+    }
+}
+
+} // namespace gdx
diff --git a/port/tests/fiber_smoketest.c b/port/tests/fiber_smoketest.c
new file mode 100644
index 0000000..d02c86d
--- /dev/null
+++ b/port/tests/fiber_smoketest.c
@@ -0,0 +1,45 @@
+#include "gdx_fiber.h"
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+enum { kFiberCount = 3, kSwitches = 10000 };
+
+static GdxFiber* sHost;
+static GdxFiber* sFibers[kFiberCount];
+static uint64_t sCanary[kFiberCount];
+static unsigned sSteps[kFiberCount];
+
+static void fiber_main(void* arg) {
+    const unsigned index = (unsigned)(uintptr_t)arg;
+    const uint64_t expected = UINT64_C(0xA5A5000000000000) | index;
+    sCanary[index] = expected;
+    for (;;) {
+        if (sCanary[index] != expected) {
+            fprintf(stderr, "fiber %u canary corrupted\n", index);
+            abort();
+        }
+        if (sSteps[index] < kSwitches) {
+            ++sSteps[index];
+        }
+        gdx_fiber_switch(sHost);
+    }
+}
+
+int main(void) {
+    sHost = gdx_fiber_convert_thread();
+    if (sHost == NULL) return 1;
+    for (unsigned i = 0; i < kFiberCount; ++i) {
+        sFibers[i] = gdx_fiber_create(fiber_main, (void*)(uintptr_t)i, 0);
+        if (sFibers[i] == NULL) return 2;
+    }
+    for (unsigned round = 0; round < kSwitches; ++round) {
+        for (unsigned i = 0; i < kFiberCount; ++i) gdx_fiber_switch(sFibers[i]);
+    }
+    for (unsigned i = 0; i < kFiberCount; ++i) {
+        if (sSteps[i] != kSwitches) return 3;
+    }
+    puts("gdx_fiber_smoketest: PASS");
+    return 0;
+}
