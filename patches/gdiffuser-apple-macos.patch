+- (UIView*)hitTest:(CGPoint)point withEvent:(UIEvent*)event {
+    UIView* hit = [super hitTest:point withEvent:event];
+    return hit == self ? nil : hit;
+}
+
+- (BOOL)isCompact {
+    return CGRectGetHeight(self.bounds) < 560.0;
+}
+
+- (NSString*)profileForCompact:(BOOL)compact {
+    return compact ? @"phone-v1" : @"tablet-v1";
+}
+
+- (NSString*)storageKeyForProfile:(NSString*)profile {
+    return [@"F0X.TouchLayout." stringByAppendingString:profile];
+}
+
+// Rebuild defaults, then apply the working overrides (loaded profile plus any
+// live editor edits) and clamp into the live safe area — exactly the
+// platform-neutral gdx_touch_layout_apply contract. The profile is loaded into
+// layoutCenters/layoutScales/hiddenControls once per device class and written
+// back only on editor Done / Reset, so unsaved editor state survives layout
+// passes and old profiles stay forward-compatible with new defaults.
+- (std::vector<GdxTouchControlSpec>)resolvedSpecs {
+    const BOOL compact = [self isCompact];
+    const GdxBaseSpec* bases = compact ? kPhoneSpecs : kTabletSpecs;
+    const int baseCount = compact ? (int)(sizeof(kPhoneSpecs) / sizeof(kPhoneSpecs[0]))
+                                  : (int)(sizeof(kTabletSpecs) / sizeof(kTabletSpecs[0]));
+
+    std::vector<GdxTouchControlSpec> defaults;
+    defaults.reserve((size_t)baseCount);
+    for (int i = 0; i < baseCount; i++) {
+        GdxTouchControlSpec spec;
+        spec.controlId = bases[i].controlId;
+        spec.centerX = bases[i].x;
+        spec.centerY = bases[i].y;
+        spec.scale = 1.0f;
+        spec.hidden = 0;
+        defaults.push_back(spec);
+    }
+
+    std::vector<GdxTouchControlSpec> overrides;
+    for (int i = 0; i < baseCount; i++) {
+        NSString* key = [NSString stringWithFormat:@"%d", bases[i].controlId];
+        NSArray<NSNumber*>* center = self.layoutCenters[key];
+        if (center == nil) {
+            continue; // no override: the code default stands
+        }
+        GdxTouchControlSpec spec;
+        spec.controlId = bases[i].controlId;
+        spec.centerX = (center.count == 2) ? center[0].floatValue : bases[i].x;
+        spec.centerY = (center.count == 2) ? center[1].floatValue : bases[i].y;
+        spec.scale = (self.layoutScales[key] != nil) ? self.layoutScales[key].floatValue : 1.0f;
+        spec.hidden = [self.hiddenControls containsObject:key] ? 1 : 0;
+        overrides.push_back(spec);
+    }
+
+    std::vector<GdxTouchControlSpec> resolved(defaults.size());
+    // Full-window normalized safe rect: centers are fractions of the whole
+    // window (HarkinianPad semantics) and the core clamps them into the live
+    // safe area.
+    const CGFloat width = CGRectGetWidth(self.bounds);
+    const CGFloat height = CGRectGetHeight(self.bounds);
+    const UIEdgeInsets safe = self.safeAreaInsets;
+    const float safeX0 = (width > 0.0f) ? (float)(safe.left / width) : 0.0f;
+    const float safeY0 = (height > 0.0f) ? (float)(safe.top / height) : 0.0f;
+    const float safeW = (width > 0.0f) ? (float)((width - safe.left - safe.right) / width) : 1.0f;
+    const float safeH = (height > 0.0f) ? (float)((height - safe.top - safe.bottom) / height) : 1.0f;
+    gdx_touch_layout_apply(defaults.data(), (int)defaults.size(), overrides.data(),
+                           (int)overrides.size(), safeX0, safeY0, safeW, safeH,
+                           resolved.data(), (int)resolved.size());
+    return resolved;
+}
+
+- (void)loadProfileIfNeeded {
+    const BOOL compact = [self isCompact];
+    NSString* profile = [self profileForCompact:compact];
+    if (_layoutNeedsProfileLoad || ![self.layoutProfile isEqualToString:profile]) {
+        self.layoutProfile = profile;
+        [self.layoutCenters removeAllObjects];
+        [self.layoutScales removeAllObjects];
+        [self.hiddenControls removeAllObjects];
+        id storedText =
+            [NSUserDefaults.standardUserDefaults objectForKey:[self storageKeyForProfile:profile]];
+        if ([storedText isKindOfClass:NSString.class]) {
+            GdxTouchControlSpec parsed[GDX_TOUCH_CTL_COUNT];
+            const int parsedCount = gdx_touch_profile_decode(
+                ((NSString*)storedText).UTF8String, parsed, GDX_TOUCH_CTL_COUNT);
+            for (int i = 0; i < parsedCount; i++) {
+                NSString* key = [NSString stringWithFormat:@"%d", parsed[i].controlId];
+                self.layoutCenters[key] = @[ @(parsed[i].centerX), @(parsed[i].centerY) ];
+                self.layoutScales[key] = @(parsed[i].scale);
+                if (parsed[i].hidden) {
+                    [self.hiddenControls addObject:key];
+                }
+            }
+        }
+        _layoutNeedsProfileLoad = NO;
+    }
+}
+
+- (void)applyLayout {
+    [self loadProfileIfNeeded];
+    const BOOL compact = [self isCompact];
+    const UIEdgeInsets safe = self.safeAreaInsets;
+    const CGFloat width = CGRectGetWidth(self.bounds);
+    const CGFloat height = CGRectGetHeight(self.bounds);
+
+    std::vector<GdxTouchControlSpec> resolved = [self resolvedSpecs];
+    const GdxBaseSpec* bases = compact ? kPhoneSpecs : kTabletSpecs;
+    const int baseCount = compact ? (int)(sizeof(kPhoneSpecs) / sizeof(kPhoneSpecs[0]))
+                                  : (int)(sizeof(kTabletSpecs) / sizeof(kTabletSpecs[0]));
+
+    for (int i = 0; i < baseCount; i++) {
+        const GdxTouchControlSpec* spec = nullptr;
+        for (size_t j = 0; j < resolved.size(); j++) {
+            if (resolved[j].controlId == bases[i].controlId) {
+                spec = &resolved[j];
+                break;
+            }
+        }
+        if (spec == nullptr) {
+            continue;
+        }
+        const CGFloat size = bases[i].baseSize * spec->scale;
+        const CGFloat pillHeight = bases[i].baseHeight > 0.0f ? bases[i].baseHeight * spec->scale : 0.0f;
+        const CGPoint center =
+            CGPointMake(spec->centerX * width, spec->centerY * height);
+
+        UIView* view = [self viewForControlId:bases[i].controlId];
+        if (bases[i].controlId == GDX_TOUCH_CTL_DPAD) {
+            [self layoutDpadGroup:center size:size compact:compact hidden:spec->hidden];
+        } else if (view != nil) {
+            view.bounds = CGRectMake(0.0, 0.0, size, pillHeight > 0.0f ? pillHeight : size);
+            view.center = center;
+            const BOOL hidden = self.layoutEditing ? NO : (spec->hidden != 0);
+            view.hidden = hidden;
+        }
+    }
+
+    [self applyOpacityEditingAware];
+    [self layoutEditorPanel];
+    [self bringSubviewToFront:self.editorPanel];
+    _lastCompact = compact;
+}
+
+- (void)applyOpacityEditingAware {
+    for (UIView* control in self.editableControls) {
+        control.alpha = self.layoutEditing ? 1.0 : self.touchControlsOpacity;
+    }
+}
+
+- (void)layoutDpadGroup:(CGPoint)center size:(CGFloat)size compact:(BOOL)compact hidden:(BOOL)hidden {
+    const CGFloat radius = (compact ? kDpadRadiusPhone : kDpadRadius) *
+                           (compact ? size / 44.0f : size / 52.0f);
+    const CGFloat buttonSize = size;
+    NSArray<GdxTouchButton*>* group = @[ self.dUp, self.dDown, self.dLeft, self.dRight ];
+    const CGPoint offsets[4] = {
+        CGPointMake(0.0, -radius),
+        CGPointMake(0.0, radius),
+        CGPointMake(-radius, 0.0),
+        CGPointMake(radius, 0.0),
+    };
+    for (NSUInteger i = 0; i < group.count; i++) {
+        GdxTouchButton* button = group[i];
+        button.bounds = CGRectMake(0.0, 0.0, buttonSize, buttonSize);
+        button.center = CGPointMake(center.x + offsets[i].x, center.y + offsets[i].y);
+        button.hidden = self.layoutEditing ? NO : hidden;
+    }
+}
+
+- (UIView*)viewForControlId:(int)controlId {
+    switch (controlId) {
+        case GDX_TOUCH_CTL_STICK: return self.stick;
+        case GDX_TOUCH_CTL_ACCEL: return self.btnAccel;
+        case GDX_TOUCH_CTL_BOOST: return self.btnBoost;
+        case GDX_TOUCH_CTL_BRAKE: return self.btnBrake;
+        case GDX_TOUCH_CTL_SLIDE_L: return self.btnSlideL;
+        case GDX_TOUCH_CTL_SLIDE_R: return self.btnSlideR;
+        case GDX_TOUCH_CTL_START: return self.btnStart;
+        case GDX_TOUCH_CTL_VIEW: return self.btnView;
+        case GDX_TOUCH_CTL_LOOK: return self.btnLook;
+        case GDX_TOUCH_CTL_CLEFT: return self.btnCLeft;
+        case GDX_TOUCH_CTL_L: return self.btnL;
+        default: return nil;
+    }
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    const BOOL compact = [self isCompact];
+    if (compact != _lastCompact) {
+        _layoutNeedsProfileLoad = YES; // device class changed (rotation on phone)
+    }
+    [self applyLayout];
+}
+
+- (void)safeAreaInsetsDidChange {
+    [super safeAreaInsetsDidChange];
+    // The window's safe area can settle after launch (status bar / home
+    // indicator transitions). Relayout so the controls and the permanent menu
+    // button always agree on the current safe rect instead of drifting apart.
+    // Profile overrides are normalized and clamp against the live safe rect,
+    // so a relayout is enough — no profile reload.
+    [self setNeedsLayout];
+}
+
+- (void)cancelAllInputs {
+    [self.stick cancelInput];
+    for (UIView* control in self.editableControls) {
+        if ([control isKindOfClass:GdxTouchButton.class]) {
+            [(GdxTouchButton*)control cancelInput];
+        }
+    }
+}
+
+- (void)setTouchOpacity:(CGFloat)opacity {
+    const CGFloat clamped = std::max(0.25f, std::min(1.0f, (float)opacity));
+    if (fabs(clamped - self.touchControlsOpacity) < 0.001f) {
+        return;
+    }
+    self.touchControlsOpacity = clamped;
+    [self applyOpacityEditingAware];
+}
+
+// ── Layout editor ─────────────────────────────────────────────────────────────
+- (UIButton*)editorButtonWithTitle:(NSString*)title action:(SEL)action {
+    UIButton* button = [UIButton buttonWithType:UIButtonTypeSystem];
+    [button setTitle:title forState:UIControlStateNormal];
+    [button setTitleColor:UIColor.whiteColor forState:UIControlStateNormal];
+    button.titleLabel.font = [UIFont systemFontOfSize:14.0 weight:UIFontWeightSemibold];
+    button.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.14];
+    button.layer.cornerRadius = 10.0;
+    [button addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+    return button;
+}
+
+- (void)installLayoutEditor {
+    self.editorPanel = [[UIView alloc] initWithFrame:CGRectZero];
+    self.editorPanel.backgroundColor = [UIColor colorWithWhite:0.04 alpha:0.88];
+    self.editorPanel.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.24].CGColor;
+    self.editorPanel.layer.borderWidth = 1.0;
+    self.editorPanel.layer.cornerRadius = 16.0;
+    self.editorPanel.hidden = YES;
+
+    self.editorLabel = [[UILabel alloc] initWithFrame:CGRectZero];
+    self.editorLabel.textColor = UIColor.whiteColor;
+    self.editorLabel.numberOfLines = 2;
+    self.editorLabel.font = [UIFont systemFontOfSize:14.0 weight:UIFontWeightSemibold];
+    [self.editorPanel addSubview:self.editorLabel];
+
+    self.sizeSlider = [[UISlider alloc] initWithFrame:CGRectZero];
+    self.sizeSlider.minimumValue = 0.70f;
+    self.sizeSlider.maximumValue = 1.50f;
+    self.sizeSlider.value = 1.0f;
+    self.sizeSlider.minimumTrackTintColor = [UIColor colorWithRed:0.28 green:0.68 blue:1.0 alpha:1.0];
+    [self.sizeSlider addTarget:self
+                        action:@selector(editorSizeChanged:)
+              forControlEvents:UIControlEventValueChanged];
+    [self.editorPanel addSubview:self.sizeSlider];
+
+    self.visibilityButton = [self editorButtonWithTitle:@"Hide" action:@selector(toggleSelectedVisibility)];
+    self.resetButton = [self editorButtonWithTitle:@"Reset" action:@selector(resetCurrentLayout)];
+    self.doneButton = [self editorButtonWithTitle:@"Done" action:@selector(endLayoutEditing)];
+    self.doneButton.backgroundColor = [UIColor colorWithRed:0.10 green:0.48 blue:0.92 alpha:0.88];
+    self.resetButton.accessibilityLabel = @"Reset touch layout";
+    self.doneButton.accessibilityLabel = @"Done editing touch layout";
+    [self.editorPanel addSubview:self.visibilityButton];
+    [self.editorPanel addSubview:self.resetButton];
+    [self.editorPanel addSubview:self.doneButton];
+    [self addSubview:self.editorPanel];
+
+    for (UIView* control in self.editableControls) {
+        UIPanGestureRecognizer* pan =
+            [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(moveControl:)];
+        UITapGestureRecognizer* tap =
+            [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(selectControlGesture:)];
+        pan.enabled = NO;
+        tap.enabled = NO;
+        [control addGestureRecognizer:pan];
+        [control addGestureRecognizer:tap];
+        [self.editGestures addObject:pan];
+        [self.editGestures addObject:tap];
+    }
+}
+
+- (void)layoutEditorPanel {
+    if (self.editorPanel.hidden) {
+        return;
+    }
+    const UIEdgeInsets safe = self.safeAreaInsets;
+    const CGFloat width = CGRectGetWidth(self.bounds);
+    const BOOL compact = [self isCompact];
+    const CGFloat panelWidth =
+        MIN(width - safe.left - safe.right - (compact ? 8.0 : 16.0), compact ? 560.0 : 720.0);
+    const CGFloat panelHeight = compact ? 50.0 : 86.0;
+    self.editorPanel.frame =
+        CGRectMake(CGRectGetMidX(self.bounds) - panelWidth * 0.5,
+                   safe.top + (compact ? 4.0 : 8.0), panelWidth, panelHeight);
+    self.editorPanel.layer.cornerRadius = compact ? 12.0 : 16.0;
+
+    const CGFloat inset = compact ? 5.0 : 12.0;
+    const CGFloat buttonWidth = compact ? 54.0 : 70.0;
+    const CGFloat gap = compact ? 4.0 : 8.0;
+    const CGFloat contentHeight = panelHeight - inset * 2.0;
+    const CGFloat trailingButtonsWidth = buttonWidth * 3.0 + gap * 2.0;
+    const CGFloat labelWidth = compact ? 94.0 : MIN(150.0, panelWidth * 0.23);
+    const CGFloat sliderX = inset + labelWidth + gap;
+    const CGFloat sliderWidth =
+        panelWidth - inset * 2.0 - labelWidth - gap - trailingButtonsWidth - gap;
+    self.editorLabel.numberOfLines = compact ? 1 : 2;
+    self.editorLabel.font =
+        [UIFont systemFontOfSize:(compact ? 11.0 : 14.0) weight:UIFontWeightSemibold];
+    self.editorLabel.frame = CGRectMake(inset, inset, labelWidth, contentHeight);
+    self.sizeSlider.frame = CGRectMake(sliderX, inset, MAX(80.0, sliderWidth), contentHeight);
+
+    CGFloat buttonX = panelWidth - inset - trailingButtonsWidth;
+    for (UIButton* button in @[ self.visibilityButton, self.resetButton, self.doneButton ]) {
+        button.titleLabel.font =
+            [UIFont systemFontOfSize:(compact ? 12.0 : 14.0) weight:UIFontWeightSemibold];
+        button.layer.cornerRadius = compact ? 8.0 : 10.0;
+        button.frame = CGRectMake(buttonX, inset, buttonWidth, contentHeight);
+        buttonX += buttonWidth + gap;
+    }
+}
+
+- (void)beginLayoutEditing {
+    if (self.layoutEditing) {
+        return;
+    }
+    [self cancelAllInputs];
+    self.layoutEditing = YES;
+    for (UIView* control in self.editableControls) {
+        if ([control respondsToSelector:@selector(setLayoutEditing:)]) {
+            [(id)control setLayoutEditing:YES];
+        }
+    }
+    for (UIGestureRecognizer* gesture in self.editGestures) {
+        gesture.enabled = YES;
+    }
+    self.editorPanel.hidden = NO;
+    [self applyLayout];
+    [self selectControl:self.btnAccel];
+    NSLog(@"[F0X] touch layout editor opened");
+}
+
+- (void)endLayoutEditing {
+    if (!self.layoutEditing) {
+        return;
+    }
+    [self saveCurrentLayout];
+    self.layoutEditing = NO;
+    for (UIView* control in self.editableControls) {
+        if ([control respondsToSelector:@selector(setLayoutEditing:)]) {
+            [(id)control setLayoutEditing:NO];
+        }
+    }
+    for (UIGestureRecognizer* gesture in self.editGestures) {
+        gesture.enabled = NO;
+    }
+    self.editorPanel.hidden = YES;
+    self.selectedControl = nil;
+    [self cancelAllInputs];
+    [self applyLayout];
+    gdx_touch_controls_haptic_feedback(0); // editor Done: light confirmation
+    NSLog(@"[F0X] touch layout saved");
+}
+
+- (void)selectControl:(UIView*)control {
+    if (!self.layoutEditing || control == nil) {
+        return;
+    }
+    // The D-pad is one editable group: selecting any button selects the group.
+    self.selectedControl = control;
+    NSString* label = control.accessibilityLabel;
+    if (label.length == 0) {
+        label = control.accessibilityIdentifier;
+    }
+    const BOOL compact = [self isCompact];
+    self.editorLabel.text =
+        compact ? [NSString stringWithFormat:@"%@ • Drag • Size", label]
+                : [NSString stringWithFormat:@"%@\nDrag to move • Size", label];
+    NSString* key = control.accessibilityIdentifier;
+    self.sizeSlider.value =
+        self.layoutScales[key] == nil ? 1.0f : self.layoutScales[key].floatValue;
+    const BOOL hidden = [self.hiddenControls containsObject:key];
+    [self.visibilityButton setTitle:(hidden ? @"Show" : @"Hide") forState:UIControlStateNormal];
+    const BOOL canHide = gdx_touch_layout_can_hide(key.intValue);
+    self.visibilityButton.enabled = canHide;
+    self.visibilityButton.alpha = canHide ? 1.0 : 0.4;
+    [self highlightSelection];
+}
+
+- (void)highlightSelection {
+    for (UIView* control in self.editableControls) {
+        const BOOL selected =
+            self.layoutEditing && control == self.selectedControl &&
+            [control.accessibilityIdentifier isEqualToString:self.selectedControl.accessibilityIdentifier];
+        control.layer.shadowColor = [UIColor colorWithRed:1.0 green:0.78 blue:0.16 alpha:1.0].CGColor;
+        control.layer.shadowRadius = selected ? 8.0 : 0.0;
+        control.layer.shadowOpacity = selected ? 1.0 : 0.0;
+        control.layer.shadowOffset = CGSizeZero;
+    }
+}
+
+- (void)selectControlGesture:(UITapGestureRecognizer*)gesture {
+    [self selectControl:gesture.view];
+}
+
+- (void)moveControl:(UIPanGestureRecognizer*)gesture {
+    UIView* control = gesture.view;
+    if (!self.layoutEditing || control == nil) {
+        return;
+    }
+    if (gesture.state == UIGestureRecognizerStateBegan) {
+        [self selectControl:control];
+    }
+    const CGPoint translation = [gesture translationInView:self];
+    if ([control.accessibilityIdentifier isEqualToString:@"11"]) {
+        // The D-pad is one editable group: drag all four buttons together.
+        for (GdxTouchButton* button in @[ self.dUp, self.dDown, self.dLeft, self.dRight ]) {
+            button.center =
+                CGPointMake(button.center.x + translation.x, button.center.y + translation.y);
+            [self clampControlToSafeBounds:button];
+        }
+        [gesture setTranslation:CGPointZero inView:self];
+        [self recordGroupCenter];
+    } else {
+        control.center =
+            CGPointMake(control.center.x + translation.x, control.center.y + translation.y);
+        [gesture setTranslation:CGPointZero inView:self];
+        [self clampControlToSafeBounds:control];
+        [self recordCenter:control];
+    }
+}
+
+- (void)recordGroupCenter {
+    const CGFloat cx = (self.dUp.center.x + self.dDown.center.x + self.dLeft.center.x +
+                        self.dRight.center.x) * 0.25;
+    const CGFloat cy = (self.dUp.center.y + self.dDown.center.y + self.dLeft.center.y +
+                        self.dRight.center.y) * 0.25;
+    const CGFloat width = CGRectGetWidth(self.bounds);
+    const CGFloat height = CGRectGetHeight(self.bounds);
+    self.layoutCenters[@"11"] = @[
+        @(cx / MAX(width, 1.0)),
+        @(cy / MAX(height, 1.0)),
+    ];
+}
+
+- (void)clampControlToSafeBounds:(UIView*)control {
+    const UIEdgeInsets safe = self.safeAreaInsets;
+    const CGFloat halfWidth = CGRectGetWidth(control.bounds) * 0.5;
+    const CGFloat halfHeight = CGRectGetHeight(control.bounds) * 0.5;
+    const CGFloat minX = safe.left + halfWidth + 4.0;
+    const CGFloat maxX = CGRectGetWidth(self.bounds) - safe.right - halfWidth - 4.0;
+    const CGFloat minY = safe.top + halfHeight + 4.0;
+    const CGFloat maxY = CGRectGetHeight(self.bounds) - safe.bottom - halfHeight - 4.0;
+    control.center = CGPointMake(
+        std::max(minX, std::min(control.center.x, maxX)),
+        std::max(minY, std::min(control.center.y, maxY)));
+}
+
+- (void)recordCenter:(UIView*)control {
+    NSString* key = control.accessibilityIdentifier;
+    if (key.length == 0) {
+        return;
+    }
+    const CGFloat width = CGRectGetWidth(self.bounds);
+    const CGFloat height = CGRectGetHeight(self.bounds);
+    self.layoutCenters[key] = @[
+        @(control.center.x / MAX(width, 1.0)),
+        @(control.center.y / MAX(height, 1.0)),
+    ];
+}
+
+- (void)editorSizeChanged:(UISlider*)slider {
+    UIView* control = self.selectedControl;
+    NSString* key = control.accessibilityIdentifier;
+    if (control == nil || key.length == 0) {
+        return;
+    }
+    const CGFloat scale = slider.value;
+    self.layoutScales[key] = @(scale);
+    [self applyLayout];
+    [self highlightSelection];
+    [self clampControlToSafeBounds:control];
+    [self recordCenter:control];
+}
+
+- (void)toggleSelectedVisibility {
+    NSString* key = self.selectedControl.accessibilityIdentifier;
+    if (key.length == 0 || !gdx_touch_layout_can_hide(key.intValue)) {
+        return;
+    }
+    if ([self.hiddenControls containsObject:key]) {
+        [self.hiddenControls removeObject:key];
+    } else {
+        [self.hiddenControls addObject:key];
+    }
+    [self applyLayout];
+    [self selectControl:self.selectedControl];
+}
+
+- (void)resetCurrentLayout {
+    if (self.layoutProfile.length == 0) {
+        return;
+    }
+    [self.layoutCenters removeAllObjects];
+    [self.layoutScales removeAllObjects];
+    [self.hiddenControls removeAllObjects];
+    [NSUserDefaults.standardUserDefaults removeObjectForKey:[self storageKeyForProfile:self.layoutProfile]];
+    _layoutNeedsProfileLoad = YES;
+    [self applyLayout];
+    if (self.layoutEditing) {
+        [self selectControl:self.btnAccel];
+    }
+    gdx_touch_controls_haptic_feedback(0); // editor Reset: light confirmation
+    NSLog(@"[F0X] touch layout reset to defaults (%@)", self.layoutProfile);
+}
+
+- (void)saveCurrentLayout {
+    if (self.layoutProfile.length == 0) {
+        return;
+    }
+    const BOOL compact = [self isCompact];
+    const GdxBaseSpec* bases = compact ? kPhoneSpecs : kTabletSpecs;
+    const int baseCount = compact ? (int)(sizeof(kPhoneSpecs) / sizeof(kPhoneSpecs[0]))
+                                  : (int)(sizeof(kTabletSpecs) / sizeof(kTabletSpecs[0]));
+    const CGFloat width = CGRectGetWidth(self.bounds);
+    const CGFloat height = CGRectGetHeight(self.bounds);
+    std::vector<GdxTouchControlSpec> specs;
+    for (int i = 0; i < baseCount; i++) {
+        GdxTouchControlSpec spec;
+        spec.controlId = bases[i].controlId;
+        UIView* view = (bases[i].controlId == GDX_TOUCH_CTL_DPAD) ? self.dUp : [self viewForControlId:bases[i].controlId];
+        const CGFloat base = bases[i].baseSize;
+        const CGFloat baseH = bases[i].baseHeight > 0.0f ? bases[i].baseHeight : base;
+        const CGFloat w = CGRectGetWidth(view.bounds);
+        const CGFloat h = CGRectGetHeight(view.bounds);
+        spec.scale = (base > 0.0f) ? (float)(w / base) : 1.0f;
+        if (baseH > base && h > 0.0f) {
+            spec.scale = (float)(h / baseH);
+        }
+        NSString* key = view.accessibilityIdentifier;
+        spec.centerX = (float)(view.center.x / MAX(width, 1.0));
+        spec.centerY = (float)(view.center.y / MAX(height, 1.0));
+        spec.hidden = [self.hiddenControls containsObject:key] ? 1 : 0;
+        specs.push_back(spec);
+    }
+    char buffer[1024];
+    const int len = gdx_touch_profile_encode(specs.data(), (int)specs.size(), buffer, (int)sizeof(buffer));
+    if (len > 0) {
+        [NSUserDefaults.standardUserDefaults setObject:[NSString stringWithUTF8String:buffer]
+                                               forKey:[self storageKeyForProfile:self.layoutProfile]];
+    }
+}
+
+@end
+
+// ── Overlay + menu-button installation ─────────────────────────────────────────
+static GdxTouchOverlay* sOverlay;
+static GdxTouchButton* sMenuButton;
+
+// Target/action holder for the permanent ••• button: UIControl actions must be
+// Objective-C methods, so the C API wrapper lives on a small retained object.
+@interface GdxMenuButtonTarget : NSObject
+@end
+
+@implementation GdxMenuButtonTarget
+- (void)menuPressed {
+    gdx_touch_menu_toggle();
+}
+@end
+
+static GdxMenuButtonTarget* sMenuTarget;
+
+static UIWindow* gdx_active_ui_window(void) {
+    for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:UIWindowScene.class]) {
+            continue;
+        }
+        for (UIWindow* window in ((UIWindowScene*)scene).windows) {
+            if (window.isKeyWindow) {
+                return window;
+            }
+        }
+    }
+    return UIApplication.sharedApplication.windows.firstObject;
+}
+
+// Compact attach diagnostic so Simulator evidence can verify the overlay maps
+// onto the live window. One line per attach, no per-control spam.
+static void gdx_log_overlay_geometry(GdxTouchOverlay* overlay) {
+    NSLog(@"[F0X] touch overlay frame=%@ hidden=%d alpha=%.2f userInteraction=%d",
+          NSStringFromCGRect(overlay.frame), overlay.hidden ? 1 : 0, overlay.alpha,
+          overlay.userInteractionEnabled ? 1 : 0);
+    // One-shot post-layout dump so Simulator evidence can verify the exact
+    // control frames match the HarkinianPad reference positions.
+    static BOOL sFramesLogged = NO;
+    if (!sFramesLogged) {
+        sFramesLogged = YES;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+                           for (UIView* control in overlay.editableControls) {
+                               NSLog(@"[F0X]   control %@ frame=%@",
+                                     control.accessibilityLabel,
+                                     NSStringFromCGRect(control.frame));
+                           }
+                       });
+    }
+}
+
+static void gdx_install_menu_button(UIWindow* window) {
+    if (sMenuButton == nil) {
+        sMenuButton =
+            [[GdxTouchButton alloc] initWithLabel:@"•••" bit:0 key:@"menu" pill:NO];
+        sMenuButton.accessibilityLabel = @"Menu";
+        sMenuButton.label.font = [UIFont systemFontOfSize:15.0 weight:UIFontWeightSemibold];
+        [sMenuButton setIdleColor:[UIColor colorWithWhite:0.04 alpha:0.42]
+                     pressedColor:[UIColor colorWithWhite:0.72 alpha:0.62]];
+        sMenuButton.autoresizingMask =
+            UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleBottomMargin;
+        sMenuTarget = [[GdxMenuButtonTarget alloc] init];
+        [sMenuButton addTarget:sMenuTarget
+                        action:@selector(menuPressed)
+              forControlEvents:UIControlEventTouchUpInside];
+    }
+
+    const UIEdgeInsets safe = window.safeAreaInsets;
+    const CGFloat width = CGRectGetWidth(window.bounds);
+    const CGFloat height = CGRectGetHeight(window.bounds);
+    const BOOL compact = height < 560.0;
+    const CGFloat size = compact ? 44.0 : 38.0;
+    const BOOL editing = sOverlay != nil && sOverlay.layoutEditing;
+
+    if (editing) {
+        sMenuButton.hidden = YES;
+        return;
+    }
+    sMenuButton.hidden = NO;
+    if (compact) {
+        // Phone: the HarkinianPad accepted slot — top-center during gameplay
+        // (clear of the Dynamic Island, which sits at a landscape corner) and
+        // bottom-center while the menu is open so it never covers the menu tabs.
+        const CGFloat y =
+            sMenuVisible ? height - safe.bottom - size - 8.0 : safe.top + 8.0;
+        sMenuButton.frame =
+            sMenuVisible
+                ? CGRectMake(width * 0.5 - size * 0.5, y, size, size)
+                : CGRectMake(width * 0.5 - size * 0.5, y, size, size);
+        sMenuButton.autoresizingMask =
+            UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleRightMargin |
+            (sMenuVisible ? UIViewAutoresizingFlexibleTopMargin
+                          : UIViewAutoresizingFlexibleBottomMargin);
+    } else {
+        // Tablet: upper-right safe area, clear of the menu content.
+        sMenuButton.frame =
+            CGRectMake(width - safe.right - size - 8.0, safe.top + 76.0, size, size);
+    }
+    sMenuButton.alpha = sOpacity;
+    if (sMenuButton.superview != window) {
+        [sMenuButton removeFromSuperview];
+        [window addSubview:sMenuButton];
+    }
+    [window bringSubviewToFront:sMenuButton];
+}
+
+static void gdx_apply_touch_state(void) {
+    if (!sStarted) {
+        return;
+    }
+    UIWindow* window = gdx_active_ui_window();
+    if (window == nil) {
+        // Window not up yet (boot transition): retry shortly.
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+                           if (sStarted) {
+                               gdx_apply_touch_state();
+                           }
+                       });
+        return;
+    }
+
+    gdx_install_menu_button(window);
+    const BOOL overlayHidden = !sDesiredEnabled || sMenuVisible || sControllerAutoHidden;
+
+    if (sEditorRequested) {
+        if (!sDesiredEnabled || sControllerAutoHidden) {
+            sEditorRequested = NO; // cannot edit while disabled / controller-hidden
+        } else if (sMenuVisible) {
+            // Keep the request; the editor opens once the menu finishes closing.
+        } else {
+            sEditorRequested = NO;
+            if (sOverlay == nil) {
+                sOverlay = [[GdxTouchOverlay alloc] initWithFrame:window.bounds];
+                sOverlay.autoresizingMask =
+                    UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+            }
+            if (sOverlay.superview != window) {
+                [sOverlay removeFromSuperview];
+                sOverlay.frame = window.bounds;
+                [window addSubview:sOverlay];
+            }
+            gdx_log_overlay_geometry(sOverlay);
+            [sOverlay setTouchOpacity:sOpacity];
+            [sOverlay beginLayoutEditing];
+            [window bringSubviewToFront:sOverlay];
+            return;
+        }
+    }
+
+    if (overlayHidden) {
+        if (sOverlay != nil) {
+            if (sOverlay.layoutEditing) {
+                [sOverlay endLayoutEditing];
+            }
+            [sOverlay cancelAllInputs];
+            [sOverlay removeFromSuperview];
+            sOverlay = nil;
+        }
+        return;
+    }
+
+    if (sOverlay == nil) {
+        sOverlay = [[GdxTouchOverlay alloc] initWithFrame:window.bounds];
+        sOverlay.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+    }
+    [sOverlay setTouchOpacity:sOpacity];
+    if (sOverlay.superview != window) {
+        [sOverlay removeFromSuperview];
+        sOverlay.frame = window.bounds;
+        [window addSubview:sOverlay];
+    }
+    gdx_log_overlay_geometry(sOverlay);
+    [window bringSubviewToFront:sOverlay];
+    [window bringSubviewToFront:sMenuButton];
+
+    // Live-state evidence, rate-limited: attach truth and the permanent menu
+    // button's frame (also serves as a Simulator click-mapping anchor).
+    static CFAbsoluteTime sLastLiveLog = 0.0;
+    const CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+    if ((now - sLastLiveLog) >= 5.0) {
+        sLastLiveLog = now;
+        NSLog(@"[F0X] touch live: overlay=%@ hidden=%d menuButton=%@ safe=%@",
+              sOverlay != nil ? @"attached" : @"none", (sOverlay != nil && sOverlay.hidden) ? 1 : 0,
+              NSStringFromCGRect(sMenuButton.frame), NSStringFromUIEdgeInsets(window.safeAreaInsets));
+    }
+}
+
+// ── Lifecycle ─────────────────────────────────────────────────────────────────
+static void gdx_install_lifecycle_observers(void) {
+    if (sLifecycleObserversInstalled) {
+        return;
+    }
+    sLifecycleObserversInstalled = YES;
+    NSNotificationCenter* notifications = NSNotificationCenter.defaultCenter;
+    for (NSNotificationName name in
+         @[ UIApplicationWillResignActiveNotification, UIApplicationDidEnterBackgroundNotification,
+            UIApplicationWillTerminateNotification ]) {
+        [notifications addObserverForName:name
+                                   object:nil
+                                    queue:NSOperationQueue.mainQueue
+                               usingBlock:^(NSNotification* notification) {
+                                   (void)notification;
+                                   gdx_touch_state_cancel_all();
+                                   if (sOverlay != nil) {
+                                       [sOverlay cancelAllInputs];
+                                   }
+                               }];
+    }
+    [notifications addObserverForName:UIApplicationDidBecomeActiveNotification
+                               object:nil
+                                queue:NSOperationQueue.mainQueue
+                           usingBlock:^(NSNotification* notification) {
+                               (void)notification;
+                               gdx_apply_touch_state();
+                           }];
+}
+
+// ── Public API ────────────────────────────────────────────────────────────────
+int gdx_touch_controls_available(void) {
+    return 1;
+}
+
+void gdx_touch_controls_start(void) {
+    gdx_main_sync(^{
+        if (sStarted) {
+            return;
+        }
+        gdx_install_lifecycle_observers();
+        sStarted = YES;
+        gdx_apply_touch_state();
+    });
+}
+
+void gdx_touch_controls_tick(int menuVisible, int physicalGamepadConnected,
+                             int enabled, float opacity) {
+    gdx_main_sync(^{
+        const BOOL menuVisibleNow = menuVisible != 0;
+        const BOOL controllerHiddenNow = physicalGamepadConnected != 0;
+        const BOOL enabledNow = enabled != 0;
+        const CGFloat opacityNow = std::max(0.25f, std::min(1.0f, (float)opacity));
+        const BOOL changed = (menuVisibleNow != sMenuVisible) ||
+                             (controllerHiddenNow != sControllerAutoHidden) ||
+                             (enabledNow != sDesiredEnabled) ||
+                             (fabs(opacityNow - sOpacity) >= 0.001f);
+        sMenuVisible = menuVisibleNow;
+        sControllerAutoHidden = controllerHiddenNow;
+        sDesiredEnabled = enabledNow;
+        sOpacity = opacityNow;
+        static BOOL sLoggedMenuState = NO;
+        if (sMenuVisible && !sLoggedMenuState) {
+            sLoggedMenuState = YES;
+            NSLog(@"[F0X] touch menu visible -> gameplay overlay hidden");
+        } else if (!sMenuVisible && sLoggedMenuState) {
+            sLoggedMenuState = NO;
+            NSLog(@"[F0X] touch menu closed -> overlay restored");
+        }
+        if (changed || !sStarted) {
+            gdx_apply_touch_state();
+        }
+        // Debounced input-state evidence: while any touch input is live, publish
+        // the exact N64 state the game will read this frame (buttons + stick) at
+        // most every 2s, plus one neutral line when the last active burst ends.
+        // This is the log seam that proves UIKit touches reach the pad state.
+        {
+            static CFAbsoluteTime sLastDump = 0.0;
+            static BOOL sWasActive = NO;
+            GdxTouchPadState state;
+            gdx_touch_state_read(&state);
+            const BOOL active = (state.buttons != 0) || (state.stickActive != 0);
+            const CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+            if (active && (now - sLastDump) >= 2.0) {
+                sLastDump = now;
+                NSLog(@"[F0X] touch state buttons=0x%04X stick=(%d,%d) active=%d",
+                      state.buttons, state.stickX, state.stickY, state.stickActive);
+            } else if (!active && sWasActive) {
+                NSLog(@"[F0X] touch state neutral (input released)");
+            }
+            sWasActive = active;
+        }
+    });
+}
+
+void gdx_touch_controls_read(GdxTouchPadState* outState) {
+    gdx_touch_state_read(outState);
+}
+
+void gdx_touch_controls_cancel_all(void) {
+    gdx_touch_state_cancel_all();
+    gdx_main_sync(^{
+        if (sOverlay != nil) {
+            [sOverlay cancelAllInputs];
+        }
+    });
+}
+
+void gdx_touch_controls_begin_layout_editor(void) {
+    gdx_main_sync(^{
+        if (!sDesiredEnabled || !sStarted) {
+            NSLog(@"[F0X] touch layout editor requires Touch Controls enabled");
+            return;
+        }
+        sEditorRequested = YES;
+        if (sMenuVisible) {
+            // Close the in-game menu; gdx_apply_touch_state opens the editor on
+            // the next tick once the menu is no longer visible.
+            gdx_touch_menu_toggle();
+        } else {
+            gdx_apply_touch_state();
+        }
+    });
+}
+
+void gdx_touch_controls_reset_current_layout(void) {
+    gdx_main_sync(^{
+        if (sOverlay != nil) {
+            [sOverlay resetCurrentLayout];
+        }
+    });
+}
+
+void gdx_touch_controls_set_haptics_enabled(int enabled) {
+    gdx_main_sync(^{
+        sHapticsEnabled = enabled != 0;
+    });
+}
+
+void gdx_touch_controls_shutdown(void) {
+    gdx_main_sync(^{
+        if (sOverlay != nil) {
+            if (sOverlay.layoutEditing) {
+                [sOverlay endLayoutEditing];
+            }
+            [sOverlay cancelAllInputs];
+            [sOverlay removeFromSuperview];
+            sOverlay = nil;
+        }
+        [sMenuButton removeFromSuperview];
+        sMenuButton = nil;
+        sStarted = NO;
+    });
+    gdx_touch_state_cancel_all();
+}
+
+// Haptic confirmation for deliberate actions only (the Z latch and editor
+// actions), matching the HarkinianPad reference and the F0X contract.
+void gdx_touch_controls_haptic_feedback(int medium) {
+    if (!sHapticsEnabled) {
+        return;
+    }
+    UIImpactFeedbackGenerator* generator =
+        [[UIImpactFeedbackGenerator alloc]
+            initWithStyle:(medium != 0 ? UIImpactFeedbackStyleMedium
+                                       : UIImpactFeedbackStyleLight)];
+    [generator impactOccurred];
+}
