diff --git a/port/gdx_touch_controls.h b/port/gdx_touch_controls.h
new file mode 100644
index 0000000..a8add2e
--- /dev/null
+++ b/port/gdx_touch_controls.h
@@ -0,0 +1,210 @@
+// port/gdx_touch_controls.h — cross-platform touch-controls API for F0X.
+//
+// One small state-oriented API is exposed to the port. Exactly one implementation
+// is compiled (see port/CMakeLists.txt):
+//   - gdx_touch_controls_ios.mm   on iOS/iPadOS (UIKit overlay, atomic N64 pad state)
+//   - gdx_touch_controls_stub.c   everywhere else (neutral no-ops)
+//
+// The shared atomic pad state, the normalized analog-stick mapping, the N64 pad
+// merge helper, the layout profile core, and the deterministic profile
+// encode/decode live in gdx_touch_state.c so the same code paths are exercised
+// by the iOS bridge, the neutral stub, and the standalone
+// gdx_touch_merge_tests regression.
+//
+// N64 button bits are the identical standard OSContPad bitmask used by the decomp
+// (decomp/include/controller.h) and libultraship. The touch layer never computes
+// pressed/released edges: gdx_update_port_inputs() in input_bridge.c remains the
+// sole owner of edges, digital-stick thresholds, repeats, and game-frame
+// alignment.
+
+#ifndef GDX_TOUCH_CONTROLS_H
+#define GDX_TOUCH_CONTROLS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(_WIN32)
+#define GDX_TOUCH_API
+#elif defined(__GNUC__) || defined(__clang__)
+#define GDX_TOUCH_API __attribute__((visibility("default")))
+#else
+#define GDX_TOUCH_API
+#endif
+
+// ── One frame of touch pad state, resolved to the N64 range the game expects ──
+typedef struct GdxTouchPadState {
+    unsigned short buttons;   // N64 OSContPad bitmask (see bits below)
+    signed char stickX;       // -80..80
+    signed char stickY;       // -80..80
+    unsigned char stickActive; // 1 only while a live touch owns the analog stick
+} GdxTouchPadState;
+
+// Standard N64 OSContPad button bits (identical in decomp/include/controller.h and
+// libultraship libultra/controller.h).
+#define GDX_TOUCH_BTN_CRIGHT 0x0001
+#define GDX_TOUCH_BTN_CLEFT  0x0002
+#define GDX_TOUCH_BTN_CDOWN  0x0004
+#define GDX_TOUCH_BTN_CUP    0x0008
+#define GDX_TOUCH_BTN_R      0x0010
+#define GDX_TOUCH_BTN_L      0x0020
+#define GDX_TOUCH_BTN_DRIGHT 0x0100
+#define GDX_TOUCH_BTN_DLEFT  0x0200
+#define GDX_TOUCH_BTN_DDOWN  0x0400
+#define GDX_TOUCH_BTN_DUP    0x0800
+#define GDX_TOUCH_BTN_START  0x1000
+#define GDX_TOUCH_BTN_Z      0x2000
+#define GDX_TOUCH_BTN_B      0x4000
+#define GDX_TOUCH_BTN_A      0x8000
+
+// ── Public API (implemented once per platform) ────────────────────────────────
+
+// 1 when this build ships the UIKit touch overlay. The Settings page hides the
+// whole Touch Controls section when this is 0, so desktop builds stay neutral.
+GDX_TOUCH_API int gdx_touch_controls_available(void);
+
+// Called once after the game has booted (post-setup, pre-frame-loop) so the
+// overlay never covers first-time setup or the F0X Home surface.
+GDX_TOUCH_API void gdx_touch_controls_start(void);
+
+// Installs the lifecycle observer without attaching the gameplay overlay.
+// Called after the host window exists so Home and first-time setup obey the
+// same foreground/background gate as gameplay.
+GDX_TOUCH_API void gdx_touch_controls_prepare_lifecycle(void);
+
+// Called once per host frame from the main loop. menuVisible is the live
+// GdxMenu visibility; physicalGamepadConnected is 1 when the Auto-hide-with-
+// controller policy should suppress the overlay (main.cpp folds the CVar and the
+// real SDL gamepad presence together); enabled/opacity are the live CVars.
+GDX_TOUCH_API void gdx_touch_controls_tick(int menuVisible,
+                                           int physicalGamepadConnected,
+                                           int enabled,
+                                           float opacity);
+
+// Reads one atomic snapshot of the touch pad state. Called from
+// gdx_controller_poll() immediately after the ControlDeck read.
+GDX_TOUCH_API void gdx_touch_controls_read(GdxTouchPadState* outState);
+
+// Clears every button and the stick, and releases every live UIKit touch view
+// state. Safe to call from any thread; the UIKit part hops to the main thread.
+GDX_TOUCH_API void gdx_touch_controls_cancel_all(void);
+
+// True while the application may advance simulation, render, and produce
+// audio. iOS flips this around lifecycle notifications; other platforms stay
+// active. Held touch state is cancelled before this becomes false.
+GDX_TOUCH_API int gdx_touch_controls_app_active(void);
+
+// Enters layout-editor mode: cancels all gameplay input, closes the in-game menu
+// if open, shows every control at full opacity, and hands the overlay to the
+// editor. No gameplay emission while editing.
+GDX_TOUCH_API void gdx_touch_controls_begin_layout_editor(void);
+
+// Removes the current device-class profile overrides and rebuilds from the code
+// defaults.
+GDX_TOUCH_API void gdx_touch_controls_reset_current_layout(void);
+
+// Optional haptic confirmation (CVar gSettings.Touch.Haptics). Inert on the
+// stub platform.
+GDX_TOUCH_API void gdx_touch_controls_set_haptics_enabled(int enabled);
+
+// Releases all input and detaches the overlay. Called at clean shutdown.
+GDX_TOUCH_API void gdx_touch_controls_shutdown(void);
+
+// ── Platform-neutral state core (gdx_touch_state.c) ──────────────────────────
+// The bridge, the stub, and the deterministic tests all drive the same core, so
+// merge/cancel/stick/profile behavior is tested against the code the iOS overlay
+// actually runs.
+
+// OR / AND-not a single button bit from a live touch. pressed=0 on touch-up,
+// touch-cancel, removal, state transition, and shutdown.
+GDX_TOUCH_API void gdx_touch_state_set_button(int buttonBit, int pressed);
+
+// Continuous analog stick input. x/y are normalized -1..1 (raw thumb deltas,
+// already divided by the stick's deflection radius). The core clamps the vector
+// to the unit circle, applies a modest deadzone, and maps continuously to the
+// N64 -80..80 range. A deadzone/release value publishes stickActive=0.
+GDX_TOUCH_API void gdx_touch_state_set_stick(float x, float y);
+
+// Releases the stick (neutral + inactive).
+GDX_TOUCH_API void gdx_touch_state_release_stick(void);
+
+// Clears every button and the stick atomically.
+GDX_TOUCH_API void gdx_touch_state_cancel_all(void);
+
+// Atomic snapshot read.
+GDX_TOUCH_API void gdx_touch_state_read(GdxTouchPadState* outState);
+
+// The exact merge input_bridge.c performs at the port-1 seam: buttons OR into the
+// live pad; an active touch stick replaces only the two analog axes; an inactive
+// touch stick leaves the physical analog untouched.
+GDX_TOUCH_API void gdx_touch_merge_pad(unsigned short* ioButtons,
+                                       signed char* ioStickX,
+                                       signed char* ioStickY,
+                                       const GdxTouchPadState* touch);
+
+// ── Layout profile core ───────────────────────────────────────────────────────
+// Hand-authored per-device defaults are rebuilt first, then saved overrides are
+// applied by control id, then every center is clamped into the live safe area
+// and every scalar size into [0.70, 1.50]. Hidden is ignored for protected
+// controls (stick, accelerator, Start, permanent menu). The same function runs
+// on device and in the deterministic tests.
+
+enum {
+    GDX_TOUCH_CTL_STICK = 0,
+    GDX_TOUCH_CTL_ACCEL,
+    GDX_TOUCH_CTL_BOOST,
+    GDX_TOUCH_CTL_BRAKE,
+    GDX_TOUCH_CTL_SLIDE_L,
+    GDX_TOUCH_CTL_SLIDE_R,
+    GDX_TOUCH_CTL_START,
+    GDX_TOUCH_CTL_VIEW, // C-right
+    GDX_TOUCH_CTL_LOOK, // C-up
+    GDX_TOUCH_CTL_CLEFT,
+    GDX_TOUCH_CTL_L,
+    GDX_TOUCH_CTL_DPAD,
+    GDX_TOUCH_CTL_MENU, // permanent; never editable or hideable
+    GDX_TOUCH_CTL_COUNT
+};
+
+typedef struct GdxTouchControlSpec {
+    int controlId;     // one of GDX_TOUCH_CTL_*
+    float centerX;     // normalized 0..1 within the safe-area rect
+    float centerY;     // normalized 0..1 within the safe-area rect
+    float scale;       // 0.70..1.50 multiplier on the device-class base size
+    int hidden;        // 0/1; ignored for protected controls
+} GdxTouchControlSpec;
+
+GDX_TOUCH_API int gdx_touch_layout_can_hide(int controlId);
+
+// Applies overrides onto defaults and clamps. safeX0/safeY0/safeW/safeH are the
+// normalized safe-area rect; degenerate (empty) rects fall back to the full
+// 0..1 range. out must have room for defaultCount entries.
+GDX_TOUCH_API void gdx_touch_layout_apply(const GdxTouchControlSpec* defaults,
+                                          int defaultCount,
+                                          const GdxTouchControlSpec* overrides,
+                                          int overrideCount,
+                                          float safeX0,
+                                          float safeY0,
+                                          float safeW,
+                                          float safeH,
+                                          GdxTouchControlSpec* out,
+                                          int outCapacity);
+
+// Deterministic versioned profile serialization used by the iOS NSUserDefaults
+// keys ("F0X.TouchLayout.phone-v1" / "F0X.TouchLayout.tablet-v1"). Text lines:
+//   "v1 <id> <centerX> <centerY> <scale> <hidden>"
+// Encode returns the number of chars written (excluding NUL) or 0 on truncation.
+// Decode returns the number of specs read.
+GDX_TOUCH_API int gdx_touch_profile_encode(const GdxTouchControlSpec* specs,
+                                           int count,
+                                           char* out,
+                                           int outCapacity);
+GDX_TOUCH_API int gdx_touch_profile_decode(const char* text,
+                                           GdxTouchControlSpec* out,
+                                           int outCapacity);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // GDX_TOUCH_CONTROLS_H
diff --git a/port/gdx_touch_controls_ios.mm b/port/gdx_touch_controls_ios.mm
new file mode 100644
index 0000000..19210f3
--- /dev/null
+++ b/port/gdx_touch_controls_ios.mm
@@ -0,0 +1,1546 @@
+// port/gdx_touch_controls_ios.mm — iOS/iPadOS UIKit touch-controls overlay.
+//
+// F0X-specific adaptation of the proven HarkinianPad product patterns
+// (ref/harkinianpad, pinned at 1197472): a transparent UIKit overlay attached to
+// the SDL-created UIWindow, independent hand-authored phone/tablet default
+// geometries, per-control UIKit touch tracking, safe-area clamping, normalized
+// versioned persisted profiles, a permanent ••• menu control, menu/editor/
+// lifecycle cancellation, opacity without hit-geometry changes, and optional
+// haptics.
+//
+// The critical difference from HarkinianPad: this overlay writes DIRECT atomic
+// N64 pad state (port/gdx_touch_state.c) instead of synthesizing SDL keyboard
+// events. The game receives truthful button-current and continuous analog
+// (-80..80) state through input_bridge.c's existing port-1 seam; edges,
+// digital-stick thresholds, and repeats stay in gdx_update_port_inputs().
+
+#import <UIKit/UIKit.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <vector>
+
+#include "gdx_touch_controls.h"
+#include "port_log.h"
+
+// Host callback provided by port/main.cpp: toggles the live GdxMenu GuiWindow
+// (not a bare CVar write — a constructed GuiWindow owns its visibility).
+extern "C" void gdx_touch_menu_toggle(void);
+
+// Shared haptic confirmation, defined at the bottom of this file; used by the
+// button press path and the editor Done action before its definition.
+// medium != 0 selects the medium impact used for deliberate latches (the
+// HarkinianPad Z-latch confirmation); 0 uses the light impact for editor
+// actions. Gated by the Haptics CVar.
+void gdx_touch_controls_haptic_feedback(int medium);
+
+static void gdx_main_sync(void (^block)(void)) {
+    if ([NSThread isMainThread]) {
+        block();
+    } else {
+        dispatch_sync(dispatch_get_main_queue(), block);
+    }
+}
+
+// ── Shared manager state (host-frame values; the atomic pad state lives in
+//    gdx_touch_state.c) ────────────────────────────────────────────────────────
+static BOOL sStarted = NO;
+static BOOL sDesiredEnabled = YES;
+static BOOL sMenuVisible = NO;
+static BOOL sControllerAutoHidden = NO;
+static CGFloat sOpacity = 0.55f;
+static BOOL sHapticsEnabled = YES;
+static BOOL sEditorRequested = NO;
+static BOOL sLifecycleObserversInstalled = NO;
+static std::atomic_bool sAppActive{ true };
+
+// ── GdxTouchButton: one N64 button, true per-control UIKit touch tracking ─────
+@interface GdxTouchButton : UIControl
+@property(nonatomic) int buttonBit;          // N64 bit (GDX_TOUCH_BTN_*)
+@property(nonatomic, copy) NSString* controlKey; // layout spec id (stringified GDX_TOUCH_CTL_*)
+@property(nonatomic) BOOL inputPressed;
+@property(nonatomic) BOOL inputLatched;      // Z hold-to-latch (HarkinianPad pattern)
+@property(nonatomic) BOOL holdToLatch;       // hold for latchDelay to lock the button down
+@property(nonatomic) NSTimeInterval latchDelay;
+@property(nonatomic) BOOL layoutEditing;     // editor mode: gameplay emission off
+@property(nonatomic) BOOL usesPillShape;
+@property(nonatomic, strong) UIColor* idleColor;
+@property(nonatomic, strong) UIColor* pressedColor;
+@property(nonatomic, strong) UIColor* latchedColor;
+@property(nonatomic, readonly) UILabel* label;
+
+- (instancetype)initWithLabel:(NSString*)label
+                        bit:(int)bit
+                        key:(NSString*)key
+                        pill:(BOOL)pill;
+- (void)cancelInput;
+- (void)applyOpacity:(CGFloat)opacity editing:(BOOL)editing;
+@end
+
+@implementation GdxTouchButton {
+    UILabel* _label;
+    NSUInteger _latchGeneration;
+}
+
+- (UILabel*)label {
+    return _label;
+}
+
+- (instancetype)initWithLabel:(NSString*)label bit:(int)bit key:(NSString*)key pill:(BOOL)pill {
+    self = [super initWithFrame:CGRectZero];
+    if (self != nil) {
+        self.buttonBit = bit;
+        self.controlKey = key;
+        self.usesPillShape = pill;
+        self.latchDelay = 0.5;
+        self.multipleTouchEnabled = YES;
+        self.idleColor = [UIColor colorWithWhite:0.04 alpha:0.38];
+        self.pressedColor = [UIColor colorWithWhite:0.72 alpha:0.48];
+        self.latchedColor = [UIColor colorWithRed:0.22 green:0.58 blue:0.96 alpha:0.92];
+        self.backgroundColor = self.idleColor;
+        self.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.58].CGColor;
+        self.layer.borderWidth = 2.0;
+        self.accessibilityLabel = label;
+        self.accessibilityIdentifier = key;
+        self.isAccessibilityElement = YES;
+
+        _label = [[UILabel alloc] initWithFrame:CGRectZero];
+        _label.text = label;
+        _label.textColor = [UIColor colorWithWhite:1.0 alpha:0.92];
+        _label.font = [UIFont systemFontOfSize:18.0 weight:UIFontWeightSemibold];
+        _label.textAlignment = NSTextAlignmentCenter;
+        _label.adjustsFontSizeToFitWidth = YES;
+        _label.minimumScaleFactor = 0.5;
+        _label.userInteractionEnabled = NO;
+        [self addSubview:_label];
+
+        [self addTarget:self
+                      action:@selector(inputDown)
+            forControlEvents:UIControlEventTouchDown];
+        [self addTarget:self
+                      action:@selector(inputDragEnter)
+            forControlEvents:UIControlEventTouchDragEnter];
+        [self addTarget:self
+                      action:@selector(inputUp)
+            forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside |
+                             UIControlEventTouchCancel | UIControlEventTouchDragExit];
+    }
+    return self;
+}
+
+- (void)layoutSubviews {
+    [super layoutSubviews];
+    self.layer.cornerRadius =
+        self.usesPillShape ? CGRectGetHeight(self.bounds) * 0.48
+                           : MIN(CGRectGetWidth(self.bounds), CGRectGetHeight(self.bounds)) * 0.5;
+    _label.frame = self.bounds;
+}
+
+- (void)setIdleColor:(UIColor*)idleColor pressedColor:(UIColor*)pressedColor {
+    self.idleColor = idleColor;
+    self.pressedColor = pressedColor;
+    [self refreshColors];
+}
+
+- (void)setHoldToLatch:(BOOL)holdToLatch {
+    if (_holdToLatch == holdToLatch) {
+        return;
+    }
+    if (!holdToLatch) {
+        [self cancelInput];
+    }
+    _holdToLatch = holdToLatch;
+}
+
+- (void)refreshColors {
+    self.backgroundColor = self.inputLatched
+                               ? self.latchedColor
+                               : (self.inputPressed ? self.pressedColor : self.idleColor);
+    self.layer.borderColor =
+        (self.inputLatched ? [UIColor colorWithRed:0.62 green:0.82 blue:1.0 alpha:1.0]
+                           : [UIColor colorWithWhite:1.0 alpha:0.58]).CGColor;
+}
+
+- (void)beginInput {
+    if (self.layoutEditing || self.inputPressed) {
+        return;
+    }
+    self.inputPressed = YES;
+    [self refreshColors];
+    gdx_touch_state_set_button(self.buttonBit, 1);
+    if (self.holdToLatch) {
+        // A sustained per-control latchDelay locks the button with haptic confirmation; a later
+        // tap releases it. Accelerator deliberately uses 1.0 s for racing ergonomics below.
+        NSUInteger generation = ++_latchGeneration;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(self.latchDelay * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+                           if (self->_latchGeneration == generation) {
+                               [self latchInput];
+                           }
+                       });
+    }
+}
+
+- (void)inputDown {
+    if (self.layoutEditing) {
+        return;
+    }
+    if (self.inputLatched) {
+        // Tap while latched: release the latch.
+        self.inputLatched = NO;
+        self.inputPressed = NO;
+        self.accessibilityValue = nil;
+        [self refreshColors];
+        gdx_touch_state_set_button(self.buttonBit, 0);
+        return;
+    }
+    [self beginInput];
+}
+
+- (void)inputDragEnter {
+    if (!self.inputLatched) {
+        [self beginInput];
+    }
+}
+
+- (void)latchInput {
+    if (!self.holdToLatch || self.layoutEditing || !self.inputPressed) {
+        return;
+    }
+    self.inputLatched = YES;
+    self.accessibilityValue = @"Locked";
+    [self refreshColors];
+    gdx_touch_controls_haptic_feedback(1); // deliberate latch: medium pulse
+}
+
+- (void)inputUp {
+    _latchGeneration++;
+    if (self.layoutEditing || self.inputLatched || !self.inputPressed) {
+        return;
+    }
+    self.inputPressed = NO;
+    [self refreshColors];
+    gdx_touch_state_set_button(self.buttonBit, 0);
+}
+
+- (void)cancelInput {
+    _latchGeneration++;
+    self.inputLatched = NO;
+    self.accessibilityValue = nil;
+    if (!self.inputPressed) {
+        [self refreshColors];
+        return;
+    }
+    self.inputPressed = NO;
+    [self refreshColors];
+    gdx_touch_state_set_button(self.buttonBit, 0);
+}
+
+- (void)applyOpacity:(CGFloat)opacity editing:(BOOL)editing {
+    self.alpha = editing ? 1.0 : opacity;
+}
+
+@end
