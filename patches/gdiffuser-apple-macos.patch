 static void gdx_sleep_until_ns(int64_t deadlineNs) {
+#if defined(__APPLE__)
+    // Darwin does not expose clock_nanosleep/TIMER_ABSTIME. Recompute the
+    // remaining monotonic interval after EINTR so this retains the absolute
+    // deadline contract instead of treating nanosleep as a one-shot delay.
+    for (;;) {
+        int64_t remainingNs = deadlineNs - gdx_monotonic_now_ns();
+        if (remainingNs <= 0) {
+            return;
+        }
+        struct timespec rel;
+        rel.tv_sec = (time_t)(remainingNs / GDX_PACER_NS_PER_SEC);
+        rel.tv_nsec = (long)(remainingNs % GDX_PACER_NS_PER_SEC);
+        if (nanosleep(&rel, NULL) == 0 || errno != EINTR) {
+            return;
+        }
+    }
+#else
     struct timespec abs;
     abs.tv_sec = (time_t)(deadlineNs / GDX_PACER_NS_PER_SEC);
     abs.tv_nsec = (long)(deadlineNs % GDX_PACER_NS_PER_SEC);
@@ -270,6 +287,7 @@ static void gdx_sleep_until_ns(int64_t deadlineNs) {
             return; // unexpected error: give up waiting rather than spin
         }
     }
+#endif
 }
 
