diff --git a/port/gdx_diagnostics.c b/port/gdx_diagnostics.c
new file mode 100644
index 0000000..ce83d26
--- /dev/null
+++ b/port/gdx_diagnostics.c
@@ -0,0 +1,180 @@
+// port/gdx_diagnostics.c — see gdx_diagnostics.h.
+
+#include "gdx_diagnostics.h"
+
+#include <ctype.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+// ── Field helpers ────────────────────────────────────────────────────────────
+
+void gdx_diagnostics_set_field(char* dst, int dstCap, const char* value) {
+    if (dst == NULL || dstCap <= 0) {
+        return;
+    }
+    if (value == NULL) {
+        dst[0] = '\0';
+        return;
+    }
+    snprintf(dst, (size_t) dstCap, "%s", value);
+}
+
+void gdx_diagnostics_append_field(char* dst, int dstCap, const char* value) {
+    if (dst == NULL || dstCap <= 0 || value == NULL) {
+        return;
+    }
+    int used = 0;
+    while (used + 1 < dstCap && dst[used] != '\0') {
+        used++;
+    }
+    if (used + 1 >= dstCap) {
+        return;
+    }
+    snprintf(dst + used, (size_t) (dstCap - used), "%s", value);
+}
+
+// ── Privacy scrub (defense-in-depth) ─────────────────────────────────────────
+
+static const char* const kSensitiveMarkers[] = {
+    "password", "passwd", "token", "secret", "apikey", "api_key",
+    "authorization", "private key", "BEGIN ", "credential",
+};
+
+static int gdx_diag_marker_hit(const char* value) {
+    if (value == NULL) {
+        return 0;
+    }
+    char lower[512];
+    int i = 0;
+    while (value[i] != '\0' && i < (int) sizeof(lower) - 1) {
+        lower[i] = (char) tolower((unsigned char) value[i]);
+        i++;
+    }
+    lower[i] = '\0';
+    for (size_t m = 0; m < sizeof(kSensitiveMarkers) / sizeof(kSensitiveMarkers[0]); m++) {
+        if (strstr(lower, kSensitiveMarkers[m]) != NULL) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static const char* gdx_diag_scrub(const char* value) {
+    return gdx_diag_marker_hit(value) ? "[REDACTED]" : value;
+}
+
+// ── Bounded writer ───────────────────────────────────────────────────────────
+
+typedef struct GdxDiagWriter {
+    char* out;
+    int cap;
+    int used;
+} GdxDiagWriter;
+
+static void gdx_diag_write(GdxDiagWriter* w, const char* text) {
+    if (w->used >= w->cap - 1) {
+        return;
+    }
+    const size_t room = (size_t) (w->cap - 1 - w->used);
+    size_t n = strlen(text);
+    if (n > room) {
+        n = room;
+    }
+    memcpy(w->out + w->used, text, n);
+    w->used += (int) n;
+    w->out[w->used] = '\0';
+}
+
+static void gdx_diag_value(GdxDiagWriter* w, const char* label, const char* value) {
+    const char* safe = (value != NULL && value[0] != '\0') ? value : "unknown";
+    char line[GDX_DIAG_MAX_REPORT];
+    snprintf(line, sizeof(line), "  %-12s = %s\n", label, gdx_diag_scrub(safe));
+    gdx_diag_write(w, line);
+}
+
+static void gdx_diag_section(GdxDiagWriter* w, const char* title) {
+    char line[128];
+    snprintf(line, sizeof(line), "\n[%s]\n", title);
+    gdx_diag_write(w, line);
+}
+
+// ── Report builder ───────────────────────────────────────────────────────────
+
+int gdx_diagnostics_build_report(const GdxDiagnosticsSource* src, char* out, int cap) {
+    if (out == NULL || cap <= 0) {
+        return 0;
+    }
+    out[0] = '\0';
+    static const GdxDiagnosticsSource kEmpty;
+    if (src == NULL) {
+        src = &kEmpty;
+    }
+
+    GdxDiagWriter w;
+    w.out = out;
+    w.cap = cap;
+    w.used = 0;
+
+    gdx_diag_write(&w, "F0X diagnostic report\n");
+    gdx_diag_section(&w, "App");
+    gdx_diag_value(&w, "name", src->app);
+    gdx_diag_value(&w, "version", src->version);
+    gdx_diag_value(&w, "build", src->build);
+
+    gdx_diag_section(&w, "System");
+    gdx_diag_value(&w, "platform", src->platform);
+    gdx_diag_value(&w, "os", src->os);
+    gdx_diag_value(&w, "arch", src->arch);
+
+    gdx_diag_section(&w, "Renderer");
+    gdx_diag_value(&w, "backend", src->renderer);
+    gdx_diag_value(&w, "metal-device", src->metalDevice);
+    gdx_diag_value(&w, "window", src->window);
+    gdx_diag_value(&w, "refresh-hz", src->refresh);
+    gdx_diag_value(&w, "interp-target", src->interpTarget);
+
+    gdx_diag_section(&w, "Game Data");
+    gdx_diag_value(&w, "data-dir-class", src->dataDirClass);
+    gdx_diag_value(&w, "archive", src->archive);
+    gdx_diag_value(&w, "save", src->save);
+
+    gdx_diag_section(&w, "Input");
+    gdx_diag_value(&w, "controllers", src->controllers);
+    gdx_diag_value(&w, "touch", src->touch);
+
+    gdx_diag_section(&w, "Scheduler");
+    gdx_diag_value(&w, "state", src->scheduler);
+
+    gdx_diag_section(&w, "Audio");
+    gdx_diag_value(&w, "state", src->audio);
+
+    gdx_diag_section(&w, "Timing");
+    gdx_diag_value(&w, "state", src->timing);
+
+    gdx_diag_section(&w, "Game State");
+    gdx_diag_value(&w, "mode", src->gameMode);
+
+    gdx_diag_section(&w, "Errors");
+    gdx_diag_value(&w, "last", src->errors);
+
+    gdx_diag_section(&w, "Notes");
+    gdx_diag_value(&w, "notes", src->notes);
+
+    return w.used;
+}
+
+// ── Neutral platform fill (Apple provides the real one in the share module) ──
+
+#if !defined(__APPLE__)
+void gdx_diagnostics_fill_platform(GdxDiagnosticsSource* src) {
+    if (src == NULL) {
+        return;
+    }
+    gdx_diagnostics_set_field(src->platform, sizeof(src->platform), "non-Apple host");
+    gdx_diagnostics_set_field(src->os, sizeof(src->os), "unknown");
+    gdx_diagnostics_set_field(src->arch, sizeof(src->arch), "unknown");
+    gdx_diagnostics_set_field(src->renderer, sizeof(src->renderer), "unknown");
+    gdx_diagnostics_set_field(src->metalDevice, sizeof(src->metalDevice), "unavailable");
+}
+#endif
diff --git a/port/gdx_diagnostics.h b/port/gdx_diagnostics.h
new file mode 100644
index 0000000..7a79a9c
--- /dev/null
+++ b/port/gdx_diagnostics.h
@@ -0,0 +1,70 @@
+// port/gdx_diagnostics.h — deterministic, privacy-safe diagnostic report core.
+//
+// The report builder is platform-neutral C so the same formatter runs in the
+// app, the share module, and the deterministic gdx_diagnostics_tests unit
+// test. Callers populate a GdxDiagnosticsSource with what the current surface
+// can honestly report; anything left empty renders as "unknown". The builder
+// redacts values that look like secrets as defense-in-depth (the collector
+// itself never receives ROM/save/signing contents).
+
+#ifndef GDX_DIAGNOSTICS_H
+#define GDX_DIAGNOSTICS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define GDX_DIAG_MAX_REPORT 16384
+
+typedef struct GdxDiagnosticsSource {
+    char app[64];
+    char version[64];
+    char build[64];
+    char platform[64];
+    char os[64];
+    char arch[64];
+    char renderer[128];
+    char metalDevice[128];
+    char window[64];
+    char refresh[64];
+    char interpTarget[64];
+    char dataDirClass[64];
+    char archive[128];
+    char save[128];
+    char controllers[128];
+    char touch[128];
+    char scheduler[128];
+    char audio[128];
+    char timing[128];
+    char gameMode[64];
+    char errors[1024];
+    char notes[512];
+} GdxDiagnosticsSource;
+
+// Builds the report into out (always NUL-terminated, at most cap bytes total).
+// Returns the number of bytes written, excluding the terminator.
+int gdx_diagnostics_build_report(const GdxDiagnosticsSource* src, char* out, int cap);
+
+// Fills platform/OS/arch/renderer fields from host queries. Apple implements
+// the real queries (Metal device name, NSProcessInfo) in the share module; the
+// neutral fallback in gdx_diagnostics.c keeps the unit test self-contained.
+void gdx_diagnostics_fill_platform(GdxDiagnosticsSource* src);
+
+// Appends a line to a source field without overflowing it (helper for callers).
+void gdx_diagnostics_set_field(char* dst, int dstCap, const char* value);
+void gdx_diagnostics_append_field(char* dst, int dstCap, const char* value);
+
+#if defined(__APPLE__)
+// Apple share-sheet action (gdx_diagnostics_share.mm): writes the report to a
+// temp file and presents the standard Share sheet (macOS picker / iOS activity
+// controller). Returns 1 when the file was written and a sheet was presented
+// or the file was revealed; 0 with `err` filled on failure.
+int gdx_diagnostics_share_apple(const char* report, const char* baseName,
+                                char* err, int errCap);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GDX_DIAGNOSTICS_H */
diff --git a/port/gdx_diagnostics_share.mm b/port/gdx_diagnostics_share.mm
new file mode 100644
index 0000000..d63c301
--- /dev/null
+++ b/port/gdx_diagnostics_share.mm
@@ -0,0 +1,106 @@
+// port/gdx_diagnostics_share.mm — Apple platform fill + Share-sheet action.
+//
+// macOS: writes the report to a temp file and presents the standard
+// NSSharingServicePicker (AirDrop/Mail/Messages/...), falling back to
+// "Reveal in Finder" if no window is available to anchor the picker.
+// iOS: writes the report and presents UIActivityViewController (the
+// overlay/menu wiring that triggers it is a later slice; the collector and
+// file artifact are identical).
+
+#import <Foundation/Foundation.h>
+
+#include <sys/utsname.h>
+#include <stdio.h>
+
+#import <Metal/Metal.h>
+
+#if TARGET_OS_OSX
+#import <AppKit/AppKit.h>
+#else
+#import <UIKit/UIKit.h>
+#endif
+
+#include "gdx_diagnostics.h"
+
+extern "C" {
+
+void gdx_diagnostics_fill_platform(GdxDiagnosticsSource* src) {
+    if (src == NULL) {
+        return;
+    }
+    gdx_diagnostics_set_field(src->platform, sizeof(src->platform),
+                              TARGET_OS_OSX ? "Apple macOS" : "Apple iOS/iPadOS");
+    NSString* osVersion = [[NSProcessInfo processInfo] operatingSystemVersionString];
+    gdx_diagnostics_set_field(src->os, sizeof(src->os),
+                              osVersion != nil ? osVersion.UTF8String : "unknown");
+    struct utsname u;
+    if (uname(&u) == 0) {
+        gdx_diagnostics_set_field(src->arch, sizeof(src->arch), u.machine);
+    }
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (device != nil) {
+        gdx_diagnostics_set_field(src->metalDevice, sizeof(src->metalDevice),
+                                  device.name.UTF8String);
+        gdx_diagnostics_set_field(src->renderer, sizeof(src->renderer), "Fast3D / Metal");
+    } else {
+        gdx_diagnostics_set_field(src->metalDevice, sizeof(src->metalDevice), "unavailable");
+        gdx_diagnostics_set_field(src->renderer, sizeof(src->renderer), "Fast3D (no Metal device)");
+    }
+}
+
+static int gdx_diag_set_error(char* err, int errCap, const char* msg) {
+    if (err != NULL && errCap > 0) {
+        snprintf(err, (size_t) errCap, "%s", msg != NULL ? msg : "share failed");
+    }
+    return 0;
+}
+
+int gdx_diagnostics_share_apple(const char* report, const char* baseName,
+                                char* err, int errCap) {
+    if (report == NULL || baseName == NULL) {
+        return gdx_diag_set_error(err, errCap, "null report or name");
+    }
+    NSDateFormatter* formatter = [[NSDateFormatter alloc] init];
+    formatter.dateFormat = @"yyyy-MM-dd-HHmmss";
+    NSString* stamp = [formatter stringFromDate:[NSDate date]];
+    NSString* fileName = [NSString stringWithFormat:@"%@-%@.txt",
+                          [NSString stringWithUTF8String:baseName], stamp];
+    NSString* path = [NSTemporaryDirectory() stringByAppendingPathComponent:fileName];
+    NSData* data = [NSData dataWithBytes:report length:strlen(report)];
+    NSError* writeError = nil;
+    if (![data writeToFile:path options:NSDataWritingAtomic error:&writeError]) {
+        return gdx_diag_set_error(err, errCap,
+                                  writeError.localizedDescription.UTF8String != nil
+                                      ? writeError.localizedDescription.UTF8String
+                                      : "report write failed");
+    }
+    NSURL* url = [NSURL fileURLWithPath:path];
+#if TARGET_OS_OSX
+    NSSharingServicePicker* picker =
+        [[NSSharingServicePicker alloc] initWithItems:@[ url ]];
+    NSWindow* window = NSApp.keyWindow != nil ? NSApp.keyWindow : NSApp.mainWindow;
+    if (window != nil) {
+        NSRect anchor = NSMakeRect(NSMidX(window.contentView.bounds),
+                                   NSMidY(window.contentView.bounds), 1.0, 1.0);
+        [picker showRelativeToRect:anchor
+                            ofView:window.contentView
+                     preferredEdge:NSMinYEdge];
+        return 1;
+    }
+    [[NSWorkspace sharedWorkspace] activateFileViewerSelectingURLs:@[ url ]];
+    return 1;
+#else
+    UIWindow* window = UIApplication.sharedApplication.windows.firstObject;
+    UIViewController* root = window.rootViewController;
+    if (root == nil) {
+        return gdx_diag_set_error(err, errCap, "no root view controller for share sheet");
+    }
+    UIActivityViewController* sheet =
+        [[UIActivityViewController alloc] initWithActivityItems:@[ url ]
+                                          applicationActivities:nil];
+    [root presentViewController:sheet animated:YES completion:nil];
+    return 1;
+#endif
+}
+
+} // extern "C"
