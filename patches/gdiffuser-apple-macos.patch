+// Native macOS file-picker bridge for the in-window first-launch setup.
+
+#import <AppKit/AppKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include <string>
+
+namespace {
+
+std::string pickFile(NSString* title, NSArray<UTType*>* contentTypes) {
+    @autoreleasepool {
+        NSOpenPanel* panel = [NSOpenPanel openPanel];
+        panel.title = title;
+        panel.message = @"Choose a local game-data file. F0X copies it into its Application Support folder.";
+        panel.canChooseFiles = YES;
+        panel.canChooseDirectories = NO;
+        panel.allowsMultipleSelection = NO;
+        panel.allowedContentTypes = contentTypes;
+        if ([panel runModal] != NSModalResponseOK || panel.URL == nil) {
+            return {};
+        }
+        return panel.URL.path.UTF8String;
+    }
+}
+
+} // namespace
+
+namespace gdx {
+
+std::string GdxPickRomFileMacOS() {
+    return pickFile(@"Select your F-Zero X ROM (US rev0)", @[
+        [UTType typeWithFilenameExtension:@"z64"],
+        [UTType typeWithFilenameExtension:@"n64"],
+        [UTType typeWithFilenameExtension:@"v64"],
+    ]);
+}
+
+std::string GdxPickDiskFileMacOS() {
+    return pickFile(@"Select your F-Zero X Expansion Kit disk", @[
+        [UTType typeWithFilenameExtension:@"ndd"],
+    ]);
+}
+
+std::string GdxPickIplFileMacOS() {
+    return pickFile(@"Select your 64DD IPL ROM", @[
+        [UTType typeWithFilenameExtension:@"n64"],
+        [UTType typeWithFilenameExtension:@"z64"],
+    ]);
+}
+
+bool GdxRevealDataDirectoryMacOS(const std::string& path) {
+    @autoreleasepool {
+        if (path.empty()) {
+            return false;
+        }
+        NSURL* url = [NSURL fileURLWithPath:[NSString stringWithUTF8String:path.c_str()]
+                               isDirectory:YES];
+        return url != nil && [[NSWorkspace sharedWorkspace] openURL:url];
+    }
+}
+
+} // namespace gdx
diff --git a/port/gdx_firstboot_picker_ios.mm b/port/gdx_firstboot_picker_ios.mm
new file mode 100644
index 0000000..02f1e38
--- /dev/null
+++ b/port/gdx_firstboot_picker_ios.mm
@@ -0,0 +1,99 @@
+// Native iOS/iPadOS document-picker bridge for the first-launch setup.
+
+#import <UIKit/UIKit.h>
+#import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
+
+#include <string>
+
+@interface GdxDocumentPickerDelegate : NSObject <UIDocumentPickerDelegate>
+@property(nonatomic, copy) NSURL* selectedURL;
+@property(nonatomic) BOOL finished;
+@end
+
+@implementation GdxDocumentPickerDelegate
+- (void)documentPicker:(UIDocumentPickerViewController*)controller didPickDocumentsAtURLs:(NSArray<NSURL*>*)urls {
+    self.selectedURL = urls.firstObject;
+    self.finished = YES;
+}
+
+- (void)documentPickerWasCancelled:(UIDocumentPickerViewController*)controller {
+    self.finished = YES;
+}
+@end
+
+namespace {
+
+UIViewController* presentingViewController() {
+    UIWindow* window = nil;
+    for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+        if (scene.activationState == UISceneActivationStateForegroundActive &&
+            [scene isKindOfClass:UIWindowScene.class]) {
+            for (UIWindow* candidate in ((UIWindowScene*)scene).windows) {
+                if (candidate.isKeyWindow) {
+                    window = candidate;
+                    break;
+                }
+            }
+        }
+        if (window != nil) {
+            break;
+        }
+    }
+    UIViewController* controller = window.rootViewController;
+    while (controller.presentedViewController != nil) {
+        controller = controller.presentedViewController;
+    }
+    return controller;
+}
+
+std::string pickFile(NSArray<UTType*>* contentTypes) {
+    @autoreleasepool {
+        UIViewController* presenter = presentingViewController();
+        if (presenter == nil) {
+            return {};
+        }
+
+        GdxDocumentPickerDelegate* delegate = [[GdxDocumentPickerDelegate alloc] init];
+        UIDocumentPickerViewController* picker =
+            [[UIDocumentPickerViewController alloc] initForOpeningContentTypes:contentTypes asCopy:NO];
+        picker.allowsMultipleSelection = NO;
+        picker.delegate = delegate;
+        [presenter presentViewController:picker animated:YES completion:nil];
+
+        while (!delegate.finished && UIApplication.sharedApplication.applicationState == UIApplicationStateActive) {
+            [[NSRunLoop currentRunLoop] runMode:NSDefaultRunLoopMode
+                                     beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.01]];
+        }
+
+        NSURL* url = delegate.selectedURL;
+        if (url == nil || ![url startAccessingSecurityScopedResource]) {
+            return {};
+        }
+        // Browse() validates and copies this path immediately. Keep its security scope alive for
+        // the remainder of this short setup process so the C++ copy remains authorized.
+        return url.fileSystemRepresentation;
+    }
+}
+
+UTType* typeForExtension(NSString* extension) {
+    UTType* type = [UTType typeWithFilenameExtension:extension];
+    return type != nil ? type : UTTypeData;
+}
+
+} // namespace
+
+namespace gdx {
+
+std::string GdxPickRomFileIOS() {
+    return pickFile(@[ typeForExtension(@"z64"), typeForExtension(@"n64"), typeForExtension(@"v64") ]);
+}
+
+std::string GdxPickDiskFileIOS() {
+    return pickFile(@[ typeForExtension(@"ndd") ]);
+}
+
+std::string GdxPickIplFileIOS() {
+    return pickFile(@[ typeForExtension(@"n64"), typeForExtension(@"z64") ]);
+}
+
+} // namespace gdx
