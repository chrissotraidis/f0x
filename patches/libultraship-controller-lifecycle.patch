+bool ConnectedPhysicalDeviceManager::GamepadHandleIsCurrent(int32_t instanceId,
+                                                             SDL_GameController* gamepad) const {
+    if (gamepad == nullptr || SDL_GameControllerGetAttached(gamepad) == SDL_FALSE) {
+        return false;
+    }
+    SDL_Joystick* joystick = SDL_GameControllerGetJoystick(gamepad);
+    return joystick != nullptr && SDL_JoystickInstanceID(joystick) == instanceId;
+}
+
+void ConnectedPhysicalDeviceManager::CloseAllGamepads() {
+    for (const auto& [instanceId, gamepad] : mConnectedSDLGamepads) {
+        if (gamepad != nullptr) {
+            SDL_GameControllerClose(gamepad);
+        }
+    }
+    mConnectedSDLGamepads.clear();
+    mConnectedSDLGamepadNames.clear();
 }
 
