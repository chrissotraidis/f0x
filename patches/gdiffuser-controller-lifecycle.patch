diff --git a/port/gdx_gamepad_router.h b/port/gdx_gamepad_router.h
new file mode 100644
index 0000000..f554336
--- /dev/null
+++ b/port/gdx_gamepad_router.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+class GdxGamepadRouter {
+  public:
+    explicit GdxGamepadRouter(uint8_t slotCount);
+
+    bool Reconcile(const std::vector<int32_t>& connectedInstanceIds);
+    int SlotForInstance(int32_t instanceId) const;
+    int32_t InstanceForSlot(uint8_t slot) const;
+    void Clear();
+
+  private:
+    std::vector<int32_t> mSlots;
+};
diff --git a/port/gdx_gamepad_router.cpp b/port/gdx_gamepad_router.cpp
new file mode 100644
index 0000000..b35755d
--- /dev/null
+++ b/port/gdx_gamepad_router.cpp
@@ -0,0 +1,48 @@
+#include "gdx_gamepad_router.h"
+
+#include <algorithm>
+
+namespace {
+constexpr int32_t kEmptySlot = -1;
+}
+
+GdxGamepadRouter::GdxGamepadRouter(uint8_t slotCount) : mSlots(slotCount, kEmptySlot) {
+}
+
+bool GdxGamepadRouter::Reconcile(const std::vector<int32_t>& connectedInstanceIds) {
+    std::vector<int32_t> connected = connectedInstanceIds;
+    std::sort(connected.begin(), connected.end());
+    connected.erase(std::unique(connected.begin(), connected.end()), connected.end());
+
+    const std::vector<int32_t> previous = mSlots;
+    for (int32_t& instanceId : mSlots) {
+        if (instanceId != kEmptySlot &&
+            !std::binary_search(connected.begin(), connected.end(), instanceId)) {
+            instanceId = kEmptySlot;
+        }
+    }
+
+    for (int32_t instanceId : connected) {
+        if (SlotForInstance(instanceId) >= 0) {
+            continue;
+        }
+        const auto freeSlot = std::find(mSlots.begin(), mSlots.end(), kEmptySlot);
+        if (freeSlot != mSlots.end()) {
+            *freeSlot = instanceId;
+        }
+    }
+    return mSlots != previous;
+}
+
+int GdxGamepadRouter::SlotForInstance(int32_t instanceId) const {
+    const auto slot = std::find(mSlots.begin(), mSlots.end(), instanceId);
+    return slot != mSlots.end() ? static_cast<int>(std::distance(mSlots.begin(), slot)) : -1;
+}
+
+int32_t GdxGamepadRouter::InstanceForSlot(uint8_t slot) const {
+    return slot < mSlots.size() ? mSlots[slot] : kEmptySlot;
+}
+
+void GdxGamepadRouter::Clear() {
+    std::fill(mSlots.begin(), mSlots.end(), kEmptySlot);
+}
diff --git a/port/tests/controller_lifecycle_tests.cpp b/port/tests/controller_lifecycle_tests.cpp
new file mode 100644
index 0000000..ecafd4c
--- /dev/null
+++ b/port/tests/controller_lifecycle_tests.cpp
@@ -0,0 +1,154 @@
+#include "gdx_gamepad_router.h"
+#include "ship/controller/physicaldevice/ConnectedPhysicalDeviceManager.h"
+
+#include <SDL2/SDL.h>
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+namespace {
+int gChecks = 0;
+int gFailures = 0;
+
+void Check(const char* what, bool condition) {
+    ++gChecks;
+    if (!condition) {
+        ++gFailures;
+        std::printf("    [x] %s\n", what);
+    }
+}
+
+int DeviceIndexForInstance(SDL_JoystickID instanceId) {
+    for (int index = 0; index < SDL_NumJoysticks(); ++index) {
+        if (SDL_JoystickGetDeviceInstanceID(index) == instanceId) {
+            return index;
+        }
+    }
+    return -1;
+}
+
+SDL_JoystickID AttachVirtualGamepad() {
+    const int deviceIndex = SDL_JoystickAttachVirtual(
+        SDL_JOYSTICK_TYPE_GAMECONTROLLER, SDL_CONTROLLER_AXIS_MAX, SDL_CONTROLLER_BUTTON_MAX, 0);
+    Check("virtual gamepad attached", deviceIndex >= 0);
+    SDL_PumpEvents();
+    return deviceIndex >= 0 ? SDL_JoystickGetDeviceInstanceID(deviceIndex) : -1;
+}
+
+void DetachVirtualGamepad(SDL_JoystickID instanceId) {
+    const int deviceIndex = DeviceIndexForInstance(instanceId);
+    Check("virtual gamepad found for detach", deviceIndex >= 0);
+    if (deviceIndex >= 0) {
+        Check("virtual gamepad detached", SDL_JoystickDetachVirtual(deviceIndex) == 0);
+    }
+}
+
+std::vector<int32_t> ConnectedIds(Ship::ConnectedPhysicalDeviceManager& manager) {
+    std::vector<int32_t> ids;
+    for (const auto& [instanceId, name] : manager.GetConnectedSDLGamepadNames()) {
+        ids.push_back(instanceId);
+    }
+    std::sort(ids.begin(), ids.end());
+    return ids;
+}
+} // namespace
+
+int main() {
+    Check("SDL gamecontroller subsystem initialized", SDL_Init(SDL_INIT_GAMECONTROLLER) == 0);
+    if (gFailures != 0) {
+        std::printf("controller lifecycle: %d/%d checks failed (%s)\n", gFailures, gChecks,
+                    SDL_GetError());
+        return 1;
+    }
+
+    {
+        Ship::ConnectedPhysicalDeviceManager manager;
+        GdxGamepadRouter router(4);
+
+        std::printf("  case: missed removal releases held button and axis\n");
+        const SDL_JoystickID first = AttachVirtualGamepad();
+        Check("startup discovers first gamepad", manager.ReconcileConnectedSDLGamepads("startup"));
+        Check("first gamepad routed", router.Reconcile(ConnectedIds(manager)));
+        Check("first gamepad owns player 1", router.SlotForInstance(first) == 0);
+
+        auto gamepads = manager.GetConnectedSDLGamepadsForPort(0);
+        Check("player 1 has one readable handle", gamepads.size() == 1);
+        if (!gamepads.empty()) {
+            SDL_GameController* gamepad = gamepads.begin()->second;
+            SDL_Joystick* joystick = SDL_GameControllerGetJoystick(gamepad);
+            SDL_JoystickSetVirtualButton(joystick, SDL_CONTROLLER_BUTTON_A, 1);
+            SDL_JoystickSetVirtualAxis(joystick, SDL_CONTROLLER_AXIS_LEFTX, 20000);
+            SDL_GameControllerUpdate();
+            Check("button held before missed removal",
+                  SDL_GameControllerGetButton(gamepad, SDL_CONTROLLER_BUTTON_A) != 0);
+            Check("axis held before missed removal",
+                  SDL_GameControllerGetAxis(gamepad, SDL_CONTROLLER_AXIS_LEFTX) != 0);
+        }
+
+        DetachVirtualGamepad(first); // Deliberately do not dispatch the queued removal event.
+        gamepads = manager.GetConnectedSDLGamepadsForPort(0);
+        uint8_t button = 0;
+        int16_t axis = 0;
+        for (const auto& [instanceId, gamepad] : gamepads) {
+            button |= SDL_GameControllerGetButton(gamepad, SDL_CONTROLLER_BUTTON_A);
+            axis = SDL_GameControllerGetAxis(gamepad, SDL_CONTROLLER_AXIS_LEFTX);
+        }
+        Check("stale handle is unreadable before reconciliation", gamepads.empty());
+        Check("held button is neutral after missed removal", button == 0);
+        Check("held axis is neutral after missed removal", axis == 0);
+        Check("stale name is excluded immediately", manager.GetConnectedSDLGamepadNames().empty());
+        Check("active check removes stale ownership",
+              manager.ReconcileConnectedSDLGamepads("active-check"));
+        Check("router releases stale player 1", router.Reconcile(ConnectedIds(manager)));
+        Check("player 1 is free", router.InstanceForSlot(0) < 0);
+
+        std::printf("  case: sole return reclaims player 1; an additional pad takes player 2\n");
+        const SDL_JoystickID returning = AttachVirtualGamepad();
+        Check("foreground discovers returning pad",
+              manager.ReconcileConnectedSDLGamepads("foreground"));
+        router.Reconcile(ConnectedIds(manager));
+        Check("sole returning pad owns player 1", router.SlotForInstance(returning) == 0);
+
+        const SDL_JoystickID second = AttachVirtualGamepad();
+        Check("add reconciliation discovers second pad",
+              manager.ReconcileConnectedSDLGamepads("add-event"));
+        router.Reconcile(ConnectedIds(manager));
+        Check("player 1 owner is preserved", router.SlotForInstance(returning) == 0);
+        Check("additional pad owns player 2", router.SlotForInstance(second) == 1);
+
+        std::printf("  case: changing player 2 preserves player 1 and the free slot\n");
+        DetachVirtualGamepad(second);
+        manager.ReconcileConnectedSDLGamepads("remove-event");
+        router.Reconcile(ConnectedIds(manager));
+        Check("surviving player 1 remains player 1", router.SlotForInstance(returning) == 0);
+        Check("departed player 2 slot is free", router.InstanceForSlot(1) < 0);
+
+        const SDL_JoystickID replacement = AttachVirtualGamepad();
+        manager.ReconcileConnectedSDLGamepads("active-check");
+        router.Reconcile(ConnectedIds(manager));
+        Check("player 1 remains stable after replacement", router.SlotForInstance(returning) == 0);
+        Check("replacement reuses player 2", router.SlotForInstance(replacement) == 1);
+
+        std::printf("  case: foreground reconciliation finds a missed additional controller\n");
+        const SDL_JoystickID third = AttachVirtualGamepad();
+        Check("foreground detects missed add", manager.ReconcileConnectedSDLGamepads("foreground"));
+        router.Reconcile(ConnectedIds(manager));
+        Check("foreground preserves player 1", router.SlotForInstance(returning) == 0);
+        Check("foreground preserves player 2", router.SlotForInstance(replacement) == 1);
+        Check("foreground assigns next free player slot", router.SlotForInstance(third) == 2);
+
+        DetachVirtualGamepad(returning);
+        DetachVirtualGamepad(replacement);
+        DetachVirtualGamepad(third);
+        manager.ReconcileConnectedSDLGamepads("test-cleanup");
+    }
+
+    SDL_Quit();
+    if (gFailures != 0) {
+        std::printf("controller lifecycle: %d/%d checks failed\n", gFailures, gChecks);
+        return 1;
+    }
+    std::printf("controller lifecycle: %d checks passed\n", gChecks);
+    return 0;
+}
