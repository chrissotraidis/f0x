+#ifdef PORT
+/* The cartridge font image is a big-endian N64 blob full of 32-bit offsets.  Rewriting
+ * it in place only works with the console's 32-bit pointers; parse it into persistent
+ * host-native objects instead (the same strategy used by the Expansion Kit audio path). */
+#define GDX_FONT_OBJECTS 256
+#define GDX_FONT_ENV_POINTS 64
+
+typedef struct {
+    u32 offset;
+    void* host;
+} GdxFontObject;
+
+typedef struct {
+    const u8* data;
+    SampleBankRelocInfo* reloc;
+    s32 fontId;
+    GdxFontObject samples[GDX_FONT_OBJECTS];
+    s32 numSamples;
+    GdxFontObject loops[GDX_FONT_OBJECTS];
+    s32 numLoops;
+    GdxFontObject books[GDX_FONT_OBJECTS];
+    s32 numBooks;
+    GdxFontObject envs[GDX_FONT_OBJECTS];
+    s32 numEnvs;
+} GdxFontConverter;
+
+static void* gdx_font_alloc(size_t size) {
+    extern void* gdx_rdram_persist_alloc_raw(size_t size, size_t align);
+    void* ptr = gdx_rdram_persist_alloc_raw(size, 16);
+    if (ptr != NULL) {
+        memset(ptr, 0, size);
+    }
+    return ptr;
+}
+
+static u32 gdx_font_u32(const u8* data) {
+    return ((u32) data[0] << 24) | ((u32) data[1] << 16) | ((u32) data[2] << 8) | data[3];
+}
+
+static s16 gdx_font_s16(const u8* data) {
+    return (s16) (((u16) data[0] << 8) | data[1]);
+}
+
+static f32 gdx_font_f32(const u8* data) {
+    union {
+        u32 word;
+        f32 value;
+    } bits;
+    bits.word = gdx_font_u32(data);
+    return bits.value;
+}
+
+static void* gdx_font_find(GdxFontObject* objects, s32 count, u32 offset) {
+    s32 i;
+    for (i = 0; i < count; i++) {
+        if (objects[i].offset == offset) {
+            return objects[i].host;
+        }
+    }
+    return NULL;
+}
+
+static void gdx_font_remember(GdxFontObject* objects, s32* count, u32 offset, void* host) {
+    if (*count < GDX_FONT_OBJECTS) {
+        objects[*count].offset = offset;
+        objects[*count].host = host;
+        (*count)++;
+    }
+}
+
+static EnvelopePoint* gdx_font_envelope(GdxFontConverter* converter, u32 offset) {
+    EnvelopePoint* envelope;
+    s32 i;
+
+    if (offset == 0) {
+        return NULL;
+    }
+    envelope = gdx_font_find(converter->envs, converter->numEnvs, offset);
+    if (envelope != NULL) {
+        return envelope;
+    }
+    envelope = gdx_font_alloc(GDX_FONT_ENV_POINTS * sizeof(*envelope));
+    if (envelope == NULL) {
+        return NULL;
+    }
+    for (i = 0; i < GDX_FONT_ENV_POINTS; i++) {
+        envelope[i].delay = gdx_font_s16(converter->data + offset + i * 4);
+        envelope[i].arg = gdx_font_s16(converter->data + offset + i * 4 + 2);
+        if (envelope[i].delay == ADSR_GOTO &&
+            (envelope[i].arg < 0 || envelope[i].arg >= GDX_FONT_ENV_POINTS)) {
+            envelope[i].arg = GDX_FONT_ENV_POINTS - 1;
+        }
+    }
+    gdx_font_remember(converter->envs, &converter->numEnvs, offset, envelope);
+    return envelope;
+}
+
+static AdpcmLoop* gdx_font_loop(GdxFontConverter* converter, u32 offset) {
+    AdpcmLoop* loop;
+    s32 i;
+
+    if (offset == 0) {
+        return NULL;
+    }
+    loop = gdx_font_find(converter->loops, converter->numLoops, offset);
+    if (loop != NULL) {
+        return loop;
+    }
+    loop = gdx_font_alloc(sizeof(*loop));
+    if (loop == NULL) {
+        return NULL;
+    }
+    loop->header.start = gdx_font_u32(converter->data + offset);
+    loop->header.end = gdx_font_u32(converter->data + offset + 4);
+    loop->header.count = gdx_font_u32(converter->data + offset + 8);
+    if (loop->header.count != 0) {
+        for (i = 0; i < 16; i++) {
+            loop->predictorState[i] = gdx_font_s16(converter->data + offset + 0x10 + i * 2);
+        }
+    }
+    gdx_font_remember(converter->loops, &converter->numLoops, offset, loop);
+    return loop;
+}
+
+static AdpcmBook* gdx_font_book(GdxFontConverter* converter, u32 offset) {
+    AdpcmBook* book;
+    s32 order;
+    s32 predictors;
+    s32 entries;
+    s32 i;
+
+    if (offset == 0) {
+        return NULL;
+    }
+    book = gdx_font_find(converter->books, converter->numBooks, offset);
+    if (book != NULL) {
+        return book;
+    }
+    order = gdx_font_u32(converter->data + offset);
+    predictors = gdx_font_u32(converter->data + offset + 4);
+    if (order < 1 || order > 8 || predictors < 1 || predictors > 8) {
+        return NULL;
+    }
+    entries = 8 * order * predictors;
+    book = gdx_font_alloc(sizeof(AdpcmBookHeader) + entries * sizeof(s16));
+    if (book == NULL) {
+        return NULL;
+    }
+    book->header.order = order;
+    book->header.numPredictors = predictors;
+    for (i = 0; i < entries; i++) {
+        book->book[i] = gdx_font_s16(converter->data + offset + 8 + i * 2);
+    }
+    gdx_font_remember(converter->books, &converter->numBooks, offset, book);
+    return book;
+}
+
+static Sample* gdx_font_sample(GdxFontConverter* converter, u32 offset) {
+    Sample* sample;
+    u32 flags;
+    u32 medium;
+    u32 rawAddress;
+
+    if (offset == 0) {
+        return NULL;
+    }
+    sample = gdx_font_find(converter->samples, converter->numSamples, offset);
+    if (sample != NULL) {
+        return sample;
+    }
+    sample = gdx_font_alloc(sizeof(*sample));
+    if (sample == NULL) {
+        return NULL;
+    }
+    flags = gdx_font_u32(converter->data + offset);
+    sample->codec = (flags >> 28) & 0xF;
+    medium = (flags >> 26) & 3;
+    sample->unk_bit26 = (flags >> 25) & 1;
+    sample->size = flags & 0xFFFFFF;
+    rawAddress = gdx_font_u32(converter->data + offset + 4);
+    if (medium == MEDIUM_RAM) {
+        sample->sampleAddr = converter->reloc->baseAddr1 + rawAddress;
+        sample->medium = converter->reloc->medium1;
+    } else if (medium == MEDIUM_LBA) {
+        sample->sampleAddr = converter->reloc->baseAddr2 + rawAddress;
+        sample->medium = converter->reloc->medium2;
+    } else {
+        sample->sampleAddr = (u8*) (uintptr_t) rawAddress;
+        sample->medium = medium;
+    }
+    sample->loop = gdx_font_loop(converter, gdx_font_u32(converter->data + offset + 8));
+    sample->book = gdx_font_book(converter, gdx_font_u32(converter->data + offset + 0xC));
+    sample->isRelocated = true;
+    if (sample->unk_bit26 && sample->medium != MEDIUM_RAM && gNumUsedSamples < ARRAY_COUNT(gUsedSamples)) {
+        gUsedSamples[gNumUsedSamples++] = sample;
+    }
+    gdx_font_remember(converter->samples, &converter->numSamples, offset, sample);
+    return sample;
+}
+
+static void gdx_font_tuned_sample(GdxFontConverter* converter, TunedSample* sample, u32 offset) {
+    sample->sample = gdx_font_sample(converter, gdx_font_u32(converter->data + offset));
+    sample->tuning = gdx_font_f32(converter->data + offset + 4);
+}
+
+static void gdx_audio_convert_font(s32 fontId, const u8* fontData, SampleBankRelocInfo* relocInfo) {
+    GdxFontConverter converter;
+    SoundFont* font = &gSoundFontList[fontId];
+    Drum** drums = NULL;
+    Instrument** instruments = NULL;
+    u32 drumsOffset;
+    s32 i;
+
+    memset(&converter, 0, sizeof(converter));
+    converter.data = fontData;
+    converter.reloc = relocInfo;
+    converter.fontId = fontId;
+    drumsOffset = gdx_font_u32(fontData);
+    if (font->numDrums > 0) {
+        drums = gdx_font_alloc(font->numDrums * sizeof(*drums));
+        if (drums != NULL && drumsOffset != 0) {
+            for (i = 0; i < font->numDrums; i++) {
+                u32 offset = gdx_font_u32(fontData + drumsOffset + i * 4);
+                if (offset != 0) {
+                    Drum* drum = gdx_font_alloc(sizeof(*drum));
+                    if (drum != NULL) {
+                        drum->adsrDecayIndex = fontData[offset];
+                        drum->pan = fontData[offset + 1];
+                        drum->isRelocated = true;
+                        gdx_font_tuned_sample(&converter, &drum->tunedSample, offset + 4);
+                        drum->envelope = gdx_font_envelope(&converter, gdx_font_u32(fontData + offset + 0xC));
+                        drums[i] = drum;
+                    }
+                }
+            }
+        }
+    }
+    if (font->numInstruments > 126) {
+        font->numInstruments = 126;
+    }
+    if (font->numInstruments > 0) {
+        instruments = gdx_font_alloc(font->numInstruments * sizeof(*instruments));
+        if (instruments != NULL) {
+            for (i = 0; i < font->numInstruments; i++) {
+                /* The N64 font header is one 32-bit drum-table offset followed immediately by
+                 * the instrument offsets. Starting at +8 shifts every instrument by one and
+                 * maps title/select BGM IDs to the next samples in the bank. */
+                u32 offset = gdx_font_u32(fontData + 4 + i * 4);
+                if (offset != 0) {
+                    Instrument* instrument = gdx_font_alloc(sizeof(*instrument));
+                    if (instrument != NULL) {
+                        instrument->isRelocated = true;
+                        instrument->normalRangeLo = fontData[offset + 1];
+                        instrument->normalRangeHi = fontData[offset + 2];
+                        instrument->adsrDecayIndex = fontData[offset + 3];
+                        instrument->envelope =
+                            gdx_font_envelope(&converter, gdx_font_u32(fontData + offset + 4));
+                        if (instrument->normalRangeLo != 0) {
+                            gdx_font_tuned_sample(&converter, &instrument->lowPitchTunedSample, offset + 8);
+                        }
+                        gdx_font_tuned_sample(&converter, &instrument->normalPitchTunedSample, offset + 0x10);
+                        if (instrument->normalRangeHi != 0x7F) {
+                            gdx_font_tuned_sample(&converter, &instrument->highPitchTunedSample, offset + 0x18);
+                        }
+                        instruments[i] = instrument;
+                    }
+                }
+            }
+        }
+    }
+    font->drums = drums;
+    font->instruments = instruments;
+}
+#endif
