{
  "schema_version": 1,
  "id": "f0x",
  "name": "F0X",
  "game": "F-Zero X (N64, US)",
  "kind": "decomp-patches",
  "status": "experimental",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64"
      ],
      "when": "in-app",
      "description": "Your own F-Zero X (USA, revision 0) ROM as a big-endian .z64 file. You choose it in F0X after installing; the build does not read it."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "tools": [
        "git",
        "cmake",
        "ninja"
      ],
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "build",
          "command": [
            "/bin/bash",
            "{repo}/scripts/build-padmint-ios.sh",
            "{output}"
          ],
          "env": {
            "F0X_BUILD_JOBS": "{jobs}"
          }
        }
      ]
    },
    "macos": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "tools": [
        "git",
        "cmake",
        "ninja"
      ],
      "output": "zip",
      "check": "none",
      "steps": [
        {
          "stage": "build",
          "command": [
            "/bin/bash",
            "{repo}/scripts/build-padmint-macos.sh",
            "{output}"
          ],
          "env": {
            "F0X_BUILD_JOBS": "{jobs}"
          }
        }
      ]
    }
  },
  "requirements": {
    "disk_gb": 5,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "min_version": "26",
        "player": true,
        "note": "Install Xcode 26 or newer with its iOS platform, then select it in Xcode Settings > Locations > Command Line Tools; Command Line Tools alone are not enough."
      },
      {
        "name": "xcrun",
        "label": "Xcode iPhoneOS SDK",
        "version_args": [
          "--sdk",
          "iphoneos",
          "--show-sdk-path"
        ],
        "player": true,
        "note": "Install Xcode 26 or newer with its iOS platform, then select it in Xcode Settings > Locations > Command Line Tools; Command Line Tools alone are not enough."
      }
    ]
  },
  "publication": {
    "public_binaries": false,
    "reason": "Each copy is built on the player's own Mac from F-Zero X decompilation sources, so it stays personal. The ROM is chosen in the app after installing."
  }
}
